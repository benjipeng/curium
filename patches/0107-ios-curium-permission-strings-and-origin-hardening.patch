From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chromium-blink-ios <noreply@github.com>
Date: Sun, 22 Nov 2026 19:04:12 -0500
Subject: [PATCH] iOS Curium: repack permission element strings, geolocation
 order, and media origin hardening

---
 .../geolocation/geolocation_service_impl.cc   | 18 +++++----
 ios/chrome/app/resources/BUILD.gn             |  4 ++
 .../app/resources/ios_chrome_repack.gni       |  8 ++++
 ios/web/content/content_permission_manager.mm | 23 ++++++++---
 ios/web/content/web_state/content_web_state.h |  2 +
 .../content/web_state/content_web_state.mm    | 40 +++++++++++++++++--
 6 files changed, 77 insertions(+), 18 deletions(-)

diff --git a/content/browser/geolocation/geolocation_service_impl.cc b/content/browser/geolocation/geolocation_service_impl.cc
index efe415e..807aa2c 100644
--- a/content/browser/geolocation/geolocation_service_impl.cc
+++ b/content/browser/geolocation/geolocation_service_impl.cc
@@ -164,14 +164,6 @@ void GeolocationServiceImpl::Bind(
                     std::make_unique<GeolocationServiceImplContext>());
   receiver_set_.set_disconnect_handler(base::BindRepeating(
       &GeolocationServiceImpl::OnDisconnected, base::Unretained(this)));
-#if BUILDFLAG(IS_IOS)
-  device::GeolocationSystemPermissionManager*
-      geolocation_system_permission_manager =
-          device::GeolocationSystemPermissionManager::GetInstance();
-  if (geolocation_system_permission_manager) {
-    geolocation_system_permission_manager->RequestSystemPermission();
-  }
-#endif
 }
 
 void GeolocationServiceImpl::CreateGeolocation(
@@ -216,6 +208,16 @@ void GeolocationServiceImpl::CreateGeolocationWithPermissionResult(
     return;
   }
 
+#if BUILDFLAG(IS_IOS)
+  // Ask the user for site permission before triggering the iOS system prompt.
+  device::GeolocationSystemPermissionManager*
+      geolocation_system_permission_manager =
+          device::GeolocationSystemPermissionManager::GetInstance();
+  if (geolocation_system_permission_manager) {
+    geolocation_system_permission_manager->RequestSystemPermission();
+  }
+#endif
+
   requesting_origin_ =
       render_frame_host_->GetMainFrame()->GetLastCommittedOrigin();
   auto requesting_url =
diff --git a/ios/chrome/app/resources/BUILD.gn b/ios/chrome/app/resources/BUILD.gn
index e7eb2a3..8ae18f1 100644
--- a/ios/chrome/app/resources/BUILD.gn
+++ b/ios/chrome/app/resources/BUILD.gn
@@ -168,6 +168,8 @@ repack("repack_unscaled_resources") {
       "$root_gen_dir/third_party/blink/public/resources/blink_scaled_resources_100_percent.pak",
       "$root_gen_dir/third_party/blink/public/resources/inspector_overlay_resources.pak",
       "$root_gen_dir/third_party/blink/public/strings/blink_strings_en-US.pak",
