+      "$root_gen_dir/third_party/blink/public/strings/permission_element_strings_en-US.pak",
       "$root_gen_dir/ui/strings/auto_image_annotation_strings_en-US.pak",
     ]
     deps += [
@@ -180,6 +182,8 @@ repack("repack_unscaled_resources") {
       "//third_party/blink/public:resources",
       "//third_party/blink/public:scaled_resources_100_percent",
       "//third_party/blink/public/strings",
+      "//third_party/blink/public/strings:permission_element_generated_strings",
+      "//third_party/blink/public/strings:permission_element_strings",
       "//ui/resources:ui_resources_grd_grit",
       "//ui/strings:auto_image_annotation_strings",
     ]
diff --git a/ios/chrome/app/resources/ios_chrome_repack.gni b/ios/chrome/app/resources/ios_chrome_repack.gni
index 093bc43..ef72b9b 100644
--- a/ios/chrome/app/resources/ios_chrome_repack.gni
+++ b/ios/chrome/app/resources/ios_chrome_repack.gni
@@ -3,6 +3,7 @@
 # found in the LICENSE file.
 
 import("//build/config/chrome_build.gni")
+import("//build/config/features.gni")
 import("//extensions/buildflags/buildflags.gni")
 import("//tools/grit/repack.gni")
 
@@ -72,6 +73,13 @@ template("ios_chrome_repack_locales") {
       deps += [ "//extensions/strings" ]
     }
 
+    if (use_blink) {
