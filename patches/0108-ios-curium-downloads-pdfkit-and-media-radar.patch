 }
 
-- (void)handleResourceLoad:(const blink::mojom::ResourceLoadInfo&)info {
+- (void)handleResourceLoad:(const blink::mojom::ResourceLoadInfo&)info
+           renderFrameHost:(nullable content::RenderFrameHost*)renderFrameHost {
   CuriumBrowserHost* browserHost = _browserHost;
   if (!browserHost || ![browserHost observesResourceLoads]) {
     return;
   }
-  NSURL* ns_url = net::NSURLWithGURL(info.final_url.is_valid()
-                                         ? info.final_url
-                                         : info.original_url);
+  const GURL& effective_url =
+      info.final_url.is_valid() ? info.final_url : info.original_url;
+  const BOOL wantsLegacy = [browserHost observesLegacyResourceLoads];
+  const BOOL wantsEvent =
+      [browserHost observesResourceEvents] &&
+      !ShouldFilterResourceForMediaRadar(effective_url,
+                                         info.request_destination);
+  if (!wantsLegacy && !wantsEvent) {
+    return;
+  }
+  NSURL* ns_url = net::NSURLWithGURL(effective_url);
   if (!ns_url) {
     return;
   }
@@ -626,17 +715,72 @@ - (void)handleResourceLoad:(const blink::mojom::ResourceLoadInfo&)info {
       info.http_status_code > 0 ? info.http_status_code : 0;
   const int64_t raw_bytes = static_cast<int64_t>(info.raw_body_bytes.InBytes());
   const int64_t content_length = raw_bytes > 0 ? raw_bytes : -1;
+
+  NSDictionary<NSString*, id>* event = nil;
+  if (wantsEvent) {
+    NSMutableDictionary<NSString*, id>* dict =
+        [NSMutableDictionary dictionaryWithCapacity:9];
+    dict[@"url"] = ns_url;
+    dict[@"httpStatusCode"] = @(status);
+    dict[@"contentLength"] = @(content_length);
+    dict[@"requestDestination"] =
+        RequestDestinationName(info.request_destination);
+    if (mime_type) {
+      dict[@"mimeType"] = mime_type;
+    }
+    if (info.original_url.is_valid() && info.original_url != effective_url) {
+      if (NSURL* orig = net::NSURLWithGURL(info.original_url)) {
+        dict[@"originalURL"] = orig;
+      }
+    }
+    if (info.referrer.is_valid()) {
+      if (NSURL* ref = net::NSURLWithGURL(info.referrer)) {
+        dict[@"referrer"] = ref;
+      }
+    }
+    // Extract frame URL and origin synchronously on the UI thread; never
+    // capture raw RenderFrameHost* into dispatch_async.
+    content::RenderFrameHost* rfh = renderFrameHost;
+    if (!rfh && _webState) {
+      if (content::WebContents* wc =
+              static_cast<web::ContentWebState*>(_webState)->GetWebContents()) {
+        rfh = wc->GetPrimaryMainFrame();
+      }
+    }
+    if (rfh) {
+      const GURL& frame_gurl = rfh->GetLastCommittedURL();
+      if (frame_gurl.is_valid()) {
+        if (NSURL* frame_ns = net::NSURLWithGURL(frame_gurl)) {
+          dict[@"frameURL"] = frame_ns;
+        }
+      }
+      const url::Origin& frame_origin = rfh->GetLastCommittedOrigin();
+      if (!frame_origin.opaque()) {
+        if (NSString* origin_str =
+                base::SysUTF8ToNSString(frame_origin.Serialize())) {
+          dict[@"frameOrigin"] = origin_str;
+        }
+      }
+    }
+    event = [dict copy];
+  }
+
   __weak CuriumTabHost* weakSelf = self;
   dispatch_async(dispatch_get_main_queue(), ^{
     CuriumTabHost* strongSelf = weakSelf;
     if (!strongSelf || !strongSelf->_webState) {
       return;
     }
-    [strongSelf->_browserHost tabHost:strongSelf
-                   didLoadResourceURL:ns_url
-                             mimeType:mime_type
-                       httpStatusCode:status
-                        contentLength:content_length];
+    if (wantsLegacy) {
+      [strongSelf->_browserHost tabHost:strongSelf
+                     didLoadResourceURL:ns_url
+                               mimeType:mime_type
+                         httpStatusCode:status
+                          contentLength:content_length];
+    }
+    if (event) {
+      [strongSelf->_browserHost tabHost:strongSelf didLoadResourceEvent:event];
+    }
   });
 }
 
