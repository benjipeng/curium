+NSError* MakeJavaScriptError(NSInteger code, NSString* description) {
+  return [NSError errorWithDomain:kCuriumJavaScriptErrorDomain
+                             code:code
+                         userInfo:@{
+                           NSLocalizedDescriptionKey : description
+                         }];
+}
+
+id BaseValueToFoundation(const base::Value& value, int depth = 0) {
+  if (depth > kMaxBaseValueDepth) {
+    return nil;
+  }
+  switch (value.type()) {
+    case base::Value::Type::NONE:
+    case base::Value::Type::BINARY:
+      return nil;
+    case base::Value::Type::BOOLEAN:
+      return @(value.GetBool());
+    case base::Value::Type::INTEGER:
+      return @(value.GetInt());
+    case base::Value::Type::DOUBLE: {
+      const double number = value.GetDouble();
+      return std::isfinite(number) ? @(number) : nil;
+    }
+    case base::Value::Type::STRING:
+      return base::SysUTF8ToNSString(value.GetString());
+    case base::Value::Type::LIST: {
+      const base::ListValue& list = value.GetList();
+      NSMutableArray* array = [NSMutableArray arrayWithCapacity:list.size()];
+      for (const base::Value& elem : list) {
+        id converted = BaseValueToFoundation(elem, depth + 1);
+        [array addObject:converted ?: [NSNull null]];
+      }
+      return [array copy];
+    }
+    case base::Value::Type::DICT: {
+      const base::DictValue& dict = value.GetDict();
+      NSMutableDictionary<NSString*, id>* result =
+          [NSMutableDictionary dictionaryWithCapacity:dict.size()];
+      for (const auto [key, item] : dict) {
+        NSString* ns_key = base::SysUTF8ToNSString(key);
+        if (!ns_key) {
+          continue;
+        }
+        id converted = BaseValueToFoundation(item, depth + 1);
+        result[ns_key] = converted ?: [NSNull null];
+      }
+      return [result copy];
+    }
+  }
+}
+
+struct FrameEvalSlot {
+  content::WeakDocumentPtr frame_doc;
+  NSMutableDictionary<NSString*, id>* dict = nil;
+  bool completed = false;
+};
+
+struct FrameEvalState {
+  __weak CuriumTabHost* weak_owner;
+  content::WeakDocumentPtr primary_doc;
+  void (^completion)(NSArray<NSDictionary<NSString*, id>*>* _Nullable,
+                     NSError* _Nullable);
+  std::vector<FrameEvalSlot> slots;
+  base::OneShotTimer timeout_timer;
+  size_t pending_count = 1;  // Includes the dispatch loop until it unwinds.
+  bool finished = false;
+
+  FrameEvalState(
+      CuriumTabHost* owner,
+      content::WeakDocumentPtr primary_document,
+      void (^completion_block)(
+          NSArray<NSDictionary<NSString*, id>*>* _Nullable,
+          NSError* _Nullable))
+      : weak_owner(owner),
+        primary_doc(std::move(primary_document)),
+        completion([completion_block copy]) {}
+
+  FrameEvalState(const FrameEvalState&) = delete;
+  FrameEvalState& operator=(const FrameEvalState&) = delete;
+
+  content::RenderFrameHost* LivePrimaryMainFrame() const {
+    CuriumTabHost* owner = weak_owner;
+    if (!owner || !owner.webState) {
+      return nullptr;
+    }
+    content::WebContents* wc =
+        static_cast<web::ContentWebState*>(owner.webState)->GetWebContents();
+    if (!wc) {
+      return nullptr;
+    }
+    content::RenderFrameHost* primary_rfh =
+        primary_doc.AsRenderFrameHostIfValid();
+    if (!primary_rfh || !primary_rfh->IsActive() ||
+        !primary_rfh->IsRenderFrameLive() ||
+        primary_rfh != wc->GetPrimaryMainFrame()) {
+      return nullptr;
+    }
+    return primary_rfh;
+  }
+
+  void OnSlotSettled() {
+    if (finished || pending_count == 0) {
+      return;
+    }
+    --pending_count;
+    if (pending_count == 0) {
+      FinishIfPending();
+    }
+  }
+
+  void FinishWithError(NSError* error) {
+    if (finished) {
+      return;
+    }
+    finished = true;
+    timeout_timer.Stop();
+    auto completion_copy = completion;
+    completion = nil;
+    slots.clear();
+    if (!completion_copy) {
+      return;
+    }
+    dispatch_async(dispatch_get_main_queue(), ^{
+      completion_copy(nil, error);
+    });
+  }
+
+  void FinishIfPending() {
+    if (finished) {
+      return;
+    }
+    CuriumTabHost* owner = weak_owner;
+    if (!owner || !owner.webState) {
+      FinishWithError(MakeJavaScriptError(
+          kCuriumJavaScriptErrorDetached,
+          @"Tab detached before JavaScript evaluation completed."));
+      return;
+    }
+    if (!LivePrimaryMainFrame()) {
+      FinishWithError(MakeJavaScriptError(
+          kCuriumJavaScriptErrorNavigated,
+          @"Primary document changed before JavaScript evaluation completed."));
+      return;
+    }
+    finished = true;
+    timeout_timer.Stop();
+    auto completion_copy = completion;
+    completion = nil;
+    NSMutableArray<NSDictionary<NSString*, id>*>* snapshot =
+        [NSMutableArray arrayWithCapacity:slots.size()];
+    for (const FrameEvalSlot& slot : slots) {
+      if (slot.completed && slot.dict) {
+        [snapshot addObject:[slot.dict copy]];
+      }
+    }
+    slots.clear();
+    if (!completion_copy) {
+      return;
+    }
+    NSArray<NSDictionary<NSString*, id>*>* immutable_results = [snapshot copy];
+    __weak CuriumTabHost* weak_owner_copy = weak_owner;
+    dispatch_async(dispatch_get_main_queue(), ^{
+      CuriumTabHost* current_owner = weak_owner_copy;
+      if (!current_owner || !current_owner.webState) {
+        completion_copy(
+            nil,
+            MakeJavaScriptError(
+                kCuriumJavaScriptErrorDetached,
+                @"Tab detached before JavaScript evaluation completed."));
+        return;
+      }
+      completion_copy(immutable_results, nil);
+    });
+  }
+
+  ~FrameEvalState() { FinishIfPending(); }
+};
+
+struct FrameEvalSlotGuard {
+  std::shared_ptr<FrameEvalState> state;
+  size_t slot_index = 0;
+
+  FrameEvalSlotGuard(std::shared_ptr<FrameEvalState> eval_state, size_t index)
+      : state(std::move(eval_state)), slot_index(index) {}
+  FrameEvalSlotGuard(FrameEvalSlotGuard&& other) noexcept
+      : state(std::move(other.state)), slot_index(other.slot_index) {}
+  FrameEvalSlotGuard& operator=(FrameEvalSlotGuard&&) = delete;
+  FrameEvalSlotGuard(const FrameEvalSlotGuard&) = delete;
+  FrameEvalSlotGuard& operator=(const FrameEvalSlotGuard&) = delete;
+
+  ~FrameEvalSlotGuard() {
+    if (state) {
+      state->OnSlotSettled();
+    }
+  }
+};
+
+void OnFrameJavaScriptEvaluated(FrameEvalSlotGuard guard, base::Value value) {
+  std::shared_ptr<FrameEvalState>& state = guard.state;
+  if (!state || state->finished || guard.slot_index >= state->slots.size()) {
+    return;
+  }
+  CuriumTabHost* owner = state->weak_owner;
+  if (!owner || !owner.webState) {
+    state->FinishWithError(MakeJavaScriptError(
+        kCuriumJavaScriptErrorDetached,
+        @"Tab detached before JavaScript evaluation completed."));
+    return;
+  }
+  content::RenderFrameHost* primary_rfh = state->LivePrimaryMainFrame();
+  if (!primary_rfh) {
+    state->FinishWithError(MakeJavaScriptError(
+        kCuriumJavaScriptErrorNavigated,
+        @"Primary document changed before JavaScript evaluation completed."));
+    return;
+  }
+  FrameEvalSlot& slot = state->slots[guard.slot_index];
+  content::RenderFrameHost* frame_rfh =
+      slot.frame_doc.AsRenderFrameHostIfValid();
+  if (!frame_rfh || !frame_rfh->IsActive() ||
+      frame_rfh->IsNestedWithinFencedFrame() ||
+      frame_rfh->GetMainFrame() != primary_rfh) {
+    return;
+  }
+  if (id converted = BaseValueToFoundation(value)) {
+    slot.dict[@"result"] = converted;
+  }
+  slot.completed = true;
+}
+
+void OnFrameEvalTimeout(std::weak_ptr<FrameEvalState> weak_state) {
+  if (std::shared_ptr<FrameEvalState> state = weak_state.lock()) {
+    state->FinishWithError(MakeJavaScriptError(
+        kCuriumJavaScriptErrorTimedOut,
+        @"JavaScript evaluation timed out."));
+  }
+}
