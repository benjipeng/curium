+  content::WebContents* wc =
+      static_cast<web::ContentWebState*>(_webState)->GetWebContents();
+  content::RenderFrameHost* main_frame =
+      wc ? wc->GetPrimaryMainFrame() : nullptr;
+  if (!main_frame || !main_frame->IsActive() ||
+      !main_frame->IsRenderFrameLive() ||
