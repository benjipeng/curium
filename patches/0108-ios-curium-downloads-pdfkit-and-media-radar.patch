From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chromium-blink-ios <noreply@github.com>
Date: Sun, 22 Nov 2026 19:07:14 -0500
Subject: [PATCH] iOS Curium: PDFKit download semantics, terminal task pruning,
 and Media Radar resource events

---
 ios/chrome/browser/curium/DEPS                |   1 +
 .../browser/curium/curium_browser_host.mm     |  38 +++-
 .../browser/curium/curium_download_task.h     |   2 +
 .../browser/curium/curium_download_task.mm    | 117 +++++++++---
 .../curium/curium_engine_contract_internal.h  |   9 +
 ios/chrome/browser/curium/curium_tab_host.mm  | 166 ++++++++++++++++--
 ios/web/content/DEPS                          |   4 +
 .../content/download/content_download_task.h  |   6 +
 .../content/download/content_download_task.mm |  61 ++++++-
 ios/web/public/download/download_task.h       |   9 +
 10 files changed, 368 insertions(+), 45 deletions(-)

