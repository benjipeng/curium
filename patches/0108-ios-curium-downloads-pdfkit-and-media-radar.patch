         base::SysUTF8ToNSString(generated.value()) ?: @"Download";
     const std::string mime = _task->GetMimeType();
     _mimeType = mime.empty() ? nil : base::SysUTF8ToNSString(mime);
+    _isExplicitDownload = _task->IsExplicitDownload();
+    _isMainFrame = _task->IsMainFrameDownload();
+    _httpMethod = [_task->GetHttpMethod() copy] ?: @"GET";
+    _terminalState = CrIOSDownloadStateCancelled;
+    _terminalTotalBytes = -1;
+    _terminalReceivedBytes = 0;
