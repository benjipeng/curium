 ]
diff --git a/ios/chrome/browser/curium/curium_browser_host.mm b/ios/chrome/browser/curium/curium_browser_host.mm
index 9e8502a..2b994ab 100644
--- a/ios/chrome/browser/curium/curium_browser_host.mm
+++ b/ios/chrome/browser/curium/curium_browser_host.mm
@@ -131,6 +131,7 @@ @implementation CuriumBrowserHost {
   BOOL _pendingTabsNotification;
   BOOL _isShutdown;
   BOOL _observesResourceLoads;
+  BOOL _observesResourceEvents;
 }
 
 @synthesize delegate = _delegate;
@@ -140,12 +141,23 @@ - (void)setDelegate:(nullable id<CrIOSBrowserHostDelegateV1>)delegate {
   _observesResourceLoads =
       [delegate respondsToSelector:@selector
                 (browserHost:tab:didLoadResourceURL:mimeType:httpStatusCode:contentLength:)];
+  _observesResourceEvents =
+      [delegate respondsToSelector:@selector
+                (browserHost:tab:didLoadResourceEvent:)];
 }
 
 - (BOOL)observesResourceLoads {
+  return (_observesResourceLoads || _observesResourceEvents) && !_isShutdown;
+}
+
+- (BOOL)observesLegacyResourceLoads {
   return _observesResourceLoads && !_isShutdown;
 }
 
+- (BOOL)observesResourceEvents {
+  return _observesResourceEvents && !_isShutdown;
+}
+
 - (instancetype)initWithBrowser:(Browser*)browser
                      sceneState:(SceneState*)sceneState {
   self = [super init];
@@ -174,7 +186,7 @@ - (void)shutdown {
   }
   _isShutdown = YES;
 
-  for (CuriumDownloadTask* task in _downloads) {
+  for (CuriumDownloadTask* task in [_downloads copy]) {
     [task invalidate];
   }
   [_downloads removeAllObjects];
@@ -525,6 +537,17 @@ - (void)tabHost:(CuriumTabHost*)tabHost
   }
 }
 
+- (void)tabHost:(CuriumTabHost*)tabHost
+    didLoadResourceEvent:(NSDictionary<NSString*, id>*)event {
+  if (_isShutdown) {
+    return;
+  }
+  if ([_delegate respondsToSelector:@selector
+                 (browserHost:tab:didLoadResourceEvent:)]) {
+    [_delegate browserHost:self tab:tabHost didLoadResourceEvent:event];
+  }
+}
+
 - (void)tabHost:(CuriumTabHost*)tabHost
     didCommitNavigationToURL:(NSURL*)url
                 navigationID:(int64_t)navigationID
@@ -603,9 +626,16 @@ - (void)handleDownloadCreated:(std::unique_ptr<web::DownloadTask>)task
     task->Cancel();
     return;
   }
-  CuriumDownloadTask* wrapper =
-      [[CuriumDownloadTask alloc] initWithDownloadTask:std::move(task)
-                                           sourceTabID:sourceTab.tabID];
+  __weak CuriumBrowserHost* weakSelf = self;
+  CuriumDownloadTask* wrapper = [[CuriumDownloadTask alloc]
+      initWithDownloadTask:std::move(task)
+               sourceTabID:sourceTab.tabID
+                onTerminal:^(CuriumDownloadTask* finished) {
+                  CuriumBrowserHost* strongSelf = weakSelf;
+                  if (strongSelf) {
+                    [strongSelf->_downloads removeObjectIdenticalTo:finished];
+                  }
+                }];
   [_downloads addObject:wrapper];
   [_delegate browserHost:self didCreateDownload:wrapper];
 }
