+      completion_copy(@[], nil);
+    });
+    return;
+  }
+
+  const std::u16string script16 = base::SysNSStringToUTF16(script);
+  auto state = std::make_shared<FrameEvalState>(
+      self, main_frame->GetWeakDocumentPtr(), completion_copy);
+  state->slots.reserve(target_ids.size());
+
+  for (const content::GlobalRenderFrameHostId& frame_id : target_ids) {
+    content::RenderFrameHost* rfh = content::RenderFrameHost::FromID(frame_id);
+    if (!rfh || !rfh->IsActive() || !rfh->IsRenderFrameLive() ||
+        rfh->IsNestedWithinFencedFrame() ||
+        rfh->GetMainFrame() != main_frame) {
+      continue;
+    }
+    NSMutableDictionary<NSString*, id>* dict =
+        [NSMutableDictionary dictionaryWithCapacity:4];
+    dict[@"isMainFrame"] = @(rfh->IsInPrimaryMainFrame());
+    const GURL& frame_gurl = rfh->GetLastCommittedURL();
+    if (frame_gurl.is_valid()) {
+      if (NSURL* frame_ns = net::NSURLWithGURL(frame_gurl)) {
+        dict[@"frameURL"] = frame_ns;
+      }
+    }
+    const url::Origin& frame_origin = rfh->GetLastCommittedOrigin();
+    if (!frame_origin.opaque()) {
+      if (NSString* origin_str =
+              base::SysUTF8ToNSString(frame_origin.Serialize())) {
+        dict[@"frameOrigin"] = origin_str;
+      }
+    }
+    FrameEvalSlot slot;
+    slot.frame_doc = rfh->GetWeakDocumentPtr();
+    slot.dict = dict;
+    state->slots.push_back(std::move(slot));
+    const size_t slot_index = state->slots.size() - 1;
+    ++state->pending_count;
+    rfh->ExecuteJavaScriptInIsolatedWorld(
+        script16,
+        base::BindOnce(&OnFrameJavaScriptEvaluated,
+                       FrameEvalSlotGuard(state, slot_index)),
+        content::ISOLATED_WORLD_ID_CONTENT_END);
+  }
