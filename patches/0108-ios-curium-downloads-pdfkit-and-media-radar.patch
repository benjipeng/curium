+  if (allFrames) {
+    main_frame->ForEachRenderFrameHostWithAction(
+        [&target_ids, main_frame](content::RenderFrameHost* rfh) {
+          if (!rfh) {
+            return content::RenderFrameHost::FrameIterationAction::kContinue;
+          }
+          if (rfh->IsNestedWithinFencedFrame() ||
+              rfh->GetMainFrame() != main_frame) {
+            return content::RenderFrameHost::FrameIterationAction::
+                kSkipChildren;
+          }
+          if (rfh->IsActive() && rfh->IsRenderFrameLive()) {
+            target_ids.push_back(rfh->GetGlobalId());
+            if (target_ids.size() >= kMaxEvaluatedFrames) {
