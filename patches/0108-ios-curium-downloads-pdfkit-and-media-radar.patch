 #include "base/memory/raw_ptr.h"
 #include "components/download/public/common/download_item.h"
 #include "content/public/browser/global_routing_id.h"
@@ -34,6 +36,10 @@ class DownloadItemData : public base::SupportsUserData::Data,
 
   BrowserContext* browser_context() const { return browser_context_; }
   GlobalRenderFrameHostId id() const { return id_; }
+  const std::string& request_method() const { return request_method_; }
+  void set_request_method(std::string method) {
+    request_method_ = std::move(method);
+  }
 
  private:
   // WebContentsObserver methods.
@@ -43,6 +49,7 @@ class DownloadItemData : public base::SupportsUserData::Data,
   static const char kKey[];
   raw_ptr<BrowserContext, DanglingUntriaged> browser_context_;
   GlobalRenderFrameHostId id_;
+  std::string request_method_;
 };
 
 // static
@@ -157,4 +164,30 @@ void DownloadItemUtils::AttachInfoForTesting(
                    : GlobalRenderFrameHostId());
 }
 
+// static
+void DownloadItemUtils::SetRequestMethod(download::DownloadItem* download_item,
+                                         std::string method) {
+  if (!download_item) {
+    return;
+  }
+  DownloadItemData* data = DownloadItemData::Get(download_item);
+  if (!data) {
+    return;
+  }
+  data->set_request_method(std::move(method));
+}
+
+// static
+std::string DownloadItemUtils::GetRequestMethod(
+    const download::DownloadItem* download_item) {
+  if (!download_item) {
+    return std::string();
+  }
+  DownloadItemData* data = DownloadItemData::Get(download_item);
+  if (!data) {
+    return std::string();
+  }
+  return data->request_method();
+}
+
 }  // namespace content
