+- (nullable NSString*)effectiveUserAgent {
+  const BOOL desktop = [self usesDesktopUserAgent];
+  if (_webState && desktop) {
+    if (content::WebContents* wc =
+            static_cast<web::ContentWebState*>(_webState)->GetWebContents()) {
+      const std::string& override_ua =
+          wc->GetUserAgentOverride().ua_string_override;
+      if (!override_ua.empty()) {
+        return base::SysUTF8ToNSString(override_ua);
+      }
+    }
+  }
+  if (web::WebClient* client = web::GetWebClient()) {
+    const std::string ua = client->GetUserAgent(
+        desktop ? web::UserAgentType::DESKTOP : web::UserAgentType::MOBILE);
+    if (!ua.empty()) {
+      return base::SysUTF8ToNSString(ua);
+    }
+  }
+  return nil;
+}
+
 - (void)loadURL:(NSURL*)url {
   if (!_webState || !url) {
     return;
@@ -609,14 +689,23 @@ - (void)handleWebStateDestroyed {
