+  if (!state->finished && state->pending_count > 1) {
+    state->timeout_timer.Start(
+        FROM_HERE, kFrameEvalTimeout,
+        base::BindOnce(&OnFrameEvalTimeout,
+                       std::weak_ptr<FrameEvalState>(state)));
+  }
+  state->OnSlotSettled();
+}
