     _observer = std::make_unique<DownloadTaskObserverAdapter>(self);
     _task->AddObserver(_observer.get());
   }
@@ -82,12 +98,37 @@ - (void)dealloc {
   [self invalidate];
 }
 
-- (void)invalidate {
-  if (_task && _observer) {
-    _task->RemoveObserver(_observer.get());
+- (void)detachAndSnapshotTerminalState:(CrIOSDownloadState)fallbackState {
+  if (_task) {
+    const CrIOSDownloadState mapped = MapDownloadState(_task->GetState());
+    _terminalState = (mapped == CrIOSDownloadStatePending ||
+                      mapped == CrIOSDownloadStateInProgress)
+                         ? fallbackState
+                         : mapped;
+    _terminalTotalBytes = _task->GetTotalBytes();
+    _terminalReceivedBytes = _task->GetReceivedBytes();
+    if (_observer) {
+      _task->RemoveObserver(_observer.get());
+    }
+  } else {
+    _terminalState = fallbackState;
   }
   _observer.reset();
   _task.reset();
+}
+
+- (void)notifyTerminal {
+  if (!_onTerminal) {
+    return;
+  }
+  void (^callback)(CuriumDownloadTask*) = _onTerminal;
+  _onTerminal = nil;
+  callback(self);
+}
+
+- (void)invalidate {
+  _onTerminal = nil;
+  [self detachAndSnapshotTerminalState:CrIOSDownloadStateCancelled];
   [self finishWithURL:nil
                 error:[NSError errorWithDomain:kCuriumDownloadErrorDomain
                                           code:-1
@@ -117,17 +158,28 @@ - (nullable NSString*)mimeType {
   return _mimeType;
 }
 
+- (BOOL)isExplicitDownload {
+  return _isExplicitDownload;
+}
+
+- (BOOL)isMainFrame {
+  return _isMainFrame;
+}
+
+- (NSString*)httpMethod {
+  return _httpMethod;
+}
+
 - (int64_t)totalBytes {
-  return _task ? _task->GetTotalBytes() : -1;
+  return _task ? _task->GetTotalBytes() : _terminalTotalBytes;
 }
 
 - (int64_t)receivedBytes {
-  return _task ? _task->GetReceivedBytes() : 0;
+  return _task ? _task->GetReceivedBytes() : _terminalReceivedBytes;
 }
 
 - (CrIOSDownloadState)state {
-  return _task ? MapDownloadState(_task->GetState())
-               : CrIOSDownloadStateCancelled;
+  return _task ? MapDownloadState(_task->GetState()) : _terminalState;
 }
 
 - (void)startWithDestinationURL:(NSURL*)destinationURL
@@ -161,25 +213,23 @@ - (void)handleTaskUpdated {
   if (!_task || !_task->IsDone()) {
     return;
   }
-  switch (_task->GetState()) {
-    case web::DownloadTask::State::kComplete: {
-      NSURL* savedURL = base::apple::FilePathToNSURL(_task->GetResponsePath());
-      [self finishWithURL:savedURL error:nil];
+  const web::DownloadTask::State taskState = _task->GetState();
+  NSURL* savedURL = nil;
+  NSError* err = nil;
+  switch (taskState) {
+    case web::DownloadTask::State::kComplete:
+      savedURL = base::apple::FilePathToNSURL(_task->GetResponsePath());
       break;
-    }
-    case web::DownloadTask::State::kCancelled: {
-      NSError* err =
-          [NSError errorWithDomain:NSCocoaErrorDomain
-                              code:NSUserCancelledError
-                          userInfo:@{
-                            NSLocalizedDescriptionKey : @"Download cancelled."
-                          }];
-      [self finishWithURL:nil error:err];
+    case web::DownloadTask::State::kCancelled:
+      err = [NSError errorWithDomain:NSCocoaErrorDomain
+                                code:NSUserCancelledError
+                            userInfo:@{
+                              NSLocalizedDescriptionKey : @"Download cancelled."
+                            }];
       break;
-    }
     case web::DownloadTask::State::kFailed:
-    case web::DownloadTask::State::kFailedNotResumable: {
-      NSError* err = [NSError
+    case web::DownloadTask::State::kFailedNotResumable:
+      err = [NSError
           errorWithDomain:kCuriumDownloadErrorDomain
                      code:_task->GetErrorCode()
                  userInfo:@{
@@ -187,16 +237,26 @@ - (void)handleTaskUpdated {
                        stringWithFormat:@"Download failed (net error %d).",
                                         _task->GetErrorCode()]
                  }];
-      [self finishWithURL:nil error:err];
       break;
-    }
     case web::DownloadTask::State::kNotStarted:
     case web::DownloadTask::State::kInProgress:
-      break;
+      return;
   }
+  // Keep strong self across completion + host pruning.
+  CuriumDownloadTask* strongSelf = self;
+  [strongSelf detachAndSnapshotTerminalState:MapDownloadState(taskState)];
+  [strongSelf finishWithURL:savedURL error:err];
+  [strongSelf notifyTerminal];
 }
 
 - (void)handleTaskDestroyed {
+  CuriumDownloadTask* strongSelf = self;
+  if (_task) {
+    _terminalTotalBytes = _task->GetTotalBytes();
+    _terminalReceivedBytes = _task->GetReceivedBytes();
+  }
+  _terminalState = CrIOSDownloadStateCancelled;
+  _observer.reset();
   _task.release();
   NSError* err =
       [NSError errorWithDomain:kCuriumDownloadErrorDomain
@@ -204,7 +264,8 @@ - (void)handleTaskDestroyed {
                       userInfo:@{
                         NSLocalizedDescriptionKey : @"Download destroyed."
                       }];
-  [self finishWithURL:nil error:err];
+  [strongSelf finishWithURL:nil error:err];
+  [strongSelf notifyTerminal];
 }
 
