From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: chromium-blink-ios <noreply@github.com>
Subject: [PATCH] iOS Blink: single-process, dual-mode JIT/jitless V8, and RAM-scaled budgets

diff --git a/content/app/content_main.cc b/content/app/content_main.cc
index 53ad968..4411bf6 100644
--- a/content/app/content_main.cc
+++ b/content/app/content_main.cc
@@ -26,7 +26,13 @@
 #include "base/profiler/sample_metadata.h"
 #include "base/run_loop.h"
 #include "base/strings/string_number_conversions.h"
+#include "base/strings/string_util.h"
 #include "base/synchronization/condition_variable.h"
+#include <stdlib.h>
+#include <string>
+#include <vector>
+
+#include "base/system/sys_info.h"
 #include "base/task/single_thread_task_executor.h"
 #include "base/task/thread_pool/thread_pool_instance.h"
 #include "base/threading/platform_thread.h"
@@ -113,6 +119,156 @@ void SetupSignalHandlers() {
 
 #endif  // BUILDFLAG(IS_POSIX) && !BUILDFLAG(IS_ANDROID)
 
+#if BUILDFLAG(IS_IOS) && !BUILDFLAG(IS_IOS_TVOS)
+// Exported by v8_libbase (v8/src/base/platform/ios-jit-memory.cc). Weak so
+// non-V8 targets linking content/app remain self-contained and default cleanly
+// to jitless mode.
+extern "C" __attribute__((weak)) int V8IOSJitPrepareForProcess(
+    size_t pool_size_bytes,
+    int allow_txm_brk);
+
+// [ios-blink-sideload] Adds |features| to a comma-separated feature switch
+// without discarding values that are already present.
+void AppendToFeatureSwitch(base::CommandLine* command_line,
+                           const char* switch_name,
+                           const std::string& features) {
+  std::string value = command_line->GetSwitchValueASCII(switch_name);
+  if (!value.empty()) {
+    value += ",";
+  }
+  value += features;
+  command_line->AppendSwitchASCII(switch_name, value);
+}
+
+// [ios-blink-sideload] Dual-mode single-process defaults for sideloaded iOS.
+// Runs V8 with JIT when JIT memory is available (native MAP_JIT on the
+// Simulator, or on a device the TXM dual-mapped pool blessed by StikDebug
+// under LiveContainer or with --curium-enable-jit), and fails closed to
+// jitless + DrumBrake Wasm otherwise.
+void AppendSideloadSwitches(base::CommandLine* command_line) {
+  // blink::switches::kJavaScriptFlags; spelled out to keep content/app free of
+  // a direct Blink dependency.
+  constexpr char kJsFlagsSwitch[] = "js-flags";
+
+  command_line->AppendSwitch(switches::kSingleProcess);
+
+  const uint64_t ram_mb =
+      base::SysInfo::AmountOfTotalPhysicalMemory().InMiB();
+
+  // Scale per-isolate V8 heap ceilings for single-process jetsam headroom
+  // (accounting for iOS kernel carveouts on 4 GB, 6 GB, and 8 GB+ devices).
+  int old_space_mb = 192;
+  int semi_space_mb = 8;
+  if (ram_mb >= 7000) {
+    old_space_mb = 512;
+    semi_space_mb = 16;
+  } else if (ram_mb >= 5120) {
+    old_space_mb = 384;
+    semi_space_mb = 16;
+  } else if (ram_mb >= 3500) {
+    old_space_mb = 256;
+    semi_space_mb = 12;
+  }
+
+  // Resolve JIT vs jitless mode:
+  //  - --curium-disable-jit forces jitless unconditionally.
+  //  - --curium-enable-jit explicitly requests JIT (including TXM brk #0xf00d).
+  //  - Inside LiveContainer (LC_HOME_PATH set), auto-probe JIT including TXM
+  //    when a debugger is attached ("Launch with JIT").
+  //  - Outside LiveContainer, devices stay jitless so Xcode/LLDB sessions
+  //    never hit spurious brk traps; the Simulator still uses native MAP_JIT.
+  int jit_mode = 0;
+  const bool force_disable_jit = command_line->HasSwitch("curium-disable-jit");
+  if (!force_disable_jit && V8IOSJitPrepareForProcess != nullptr) {
+    const bool explicit_enable_jit =
+        command_line->HasSwitch("curium-enable-jit");
+    const bool in_livecontainer = getenv("LC_HOME_PATH") != nullptr;
+    const int allow_txm_brk = (explicit_enable_jit || in_livecontainer) ? 1 : 0;
+
+    // Default TXM code-range pool: 64 MiB (V8's arm64 kMinimumCodeRangeSize),
+    // overridable via --curium-jit-pool-mb=N (clamped to [64, 256] MiB).
+    size_t pool_mb = 64;
+    if (command_line->HasSwitch("curium-jit-pool-mb")) {
+      int parsed = 0;
+      if (base::StringToInt(
+              command_line->GetSwitchValueASCII("curium-jit-pool-mb"),
+              &parsed)) {
+        if (parsed < 64) parsed = 64;
+        if (parsed > 256) parsed = 256;
+        pool_mb = static_cast<size_t>(parsed);
+      }
+    }
+    jit_mode =
+        V8IOSJitPrepareForProcess(pool_mb * 1024ULL * 1024ULL, allow_txm_brk);
+  }
+
+  // gin applies --js-flags one comma-separated item at a time, after V8's
+  // feature flags. Parsing each item on its own keeps an unrecognized caller
+  // flag from hiding ours, and appending the jitless items last keeps a caller
+  // negation from undoing them.
+  const std::string existing_js_flags =
+      command_line->GetSwitchValueASCII(kJsFlagsSwitch);
+  std::vector<std::string> js_flags;
+  constexpr int kTxmDualMap = 3;  // V8IOSJitPrepareForProcess ABI.
+  if (jit_mode == kTxmDualMap) {
+    // Leave room for JS and other modules in the shared range. V8 can still
+    // reserve more for jump tables and grow later. Caller flags take precedence.
+    js_flags.push_back("--wasm-max-initial-code-space-reservation=8");
+  }
+  if (!existing_js_flags.empty()) {
+    js_flags.push_back(existing_js_flags);
+  }
+  if (existing_js_flags.find("--max-old-space-size=") == std::string::npos) {
+    js_flags.push_back("--max-old-space-size=" +
+                       base::NumberToString(old_space_mb));
+  }
+  if (existing_js_flags.find("--max-semi-space-size=") == std::string::npos) {
+    js_flags.push_back("--max-semi-space-size=" +
+                       base::NumberToString(semi_space_mb));
+  }
+  if (jit_mode == 0) {
+    // DrumBrake runs WebAssembly only with --wasm-jitless under --jitless.
+    js_flags.push_back("--jitless");
+    js_flags.push_back("--wasm-jitless");
+  }
+  command_line->RemoveSwitch(kJsFlagsSwitch);
+  command_line->AppendSwitchASCII(kJsFlagsSwitch,
+                                  base::JoinString(js_flags, ","));
+
+  // In-process, the GPU watchdog killing a slow GPU thread takes the whole app
+  // down; a slow first GL/ANGLE init is expected here.
+  command_line->AppendSwitch("disable-gpu-watchdog");
+
+  // Cap the compositor's estimate of available GPU memory so tile caches on
+  // heavy pages do not push the single process over the jetsam limit.
+  if (!command_line->HasSwitch("force-gpu-mem-available-mb")) {
+    command_line->AppendSwitchASCII(
+        "force-gpu-mem-available-mb",
+        ram_mb >= 7000 ? "256" : (ram_mb >= 5120 ? "192" : (ram_mb >= 3500 ? "160" : "128")));
+  }
+
+  // The Optimization Guide is disabled below, and Gemini dereferences it
+  // unchecked; Gemini also needs Google keys and sign-in, so turn it off.
+  AppendToFeatureSwitch(command_line, switches::kEnableFeatures,
+                        "WebContentsDiscard,GeminiKillSwitch");
+  // AVSampleBufferDisplayLayer video needs extra fixes before it draws through
+  // the in-process layer tree, and the
+  // back/forward cache keeps whole pages alive inside the one process.
+  // NetTaskScheduler would point net::GetTaskRunner() at the in-process
+  // network service thread, while the Chrome app's ios/web NetworkContext
+  // runs its URLLoaders on the IO thread.
+  AppendToFeatureSwitch(command_line, switches::kDisableFeatures,
+                        "avfoundation-overlays,BackForwardCache,"
+                        "NetTaskScheduler,OptimizationHints,"
+                        "OptimizationTargetPrediction,"
+                        "OptimizationGuideModelExecution,"
+                        "OptimizationGuidePageContentExtraction,"
+                        "ModelQualityLogging,PageContentCache,"
+                        "PageSettledMonitor,"
+                        "PageContentExtractionUsingPageSettledMonitor");
+}
+#endif  // BUILDFLAG(IS_IOS) && !BUILDFLAG(IS_IOS_TVOS)
+
 bool IsSubprocess() {
   auto type = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
       switches::kProcessType);
@@ -288,6 +444,9 @@ NO_STACK_PROTECTOR int RunContentProcess(
     // Enable spatial navigation; we interpret remote control swipes as arrow
     // keys.
     command_line->AppendSwitch(switches::kEnableSpatialNavigation);
+#else
+    // [ios-blink-sideload] Single-process, dual-mode JIT/jitless defaults.
+    AppendSideloadSwitches(command_line);
 #endif
 #endif
 
