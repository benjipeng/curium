+  if (!profile || profile->IsOffTheRecord()) {
+    return;
+  }
+  auto* client = extensions::IOSExtensionsBrowserClient::GetInstance();
+  content::BrowserContext* browser_context =
+      web::ContentBrowserContext::FromBrowserState(profile);
+  if (!client || !browser_context || !client->IsValidContext(browser_context)) {
+    return;
+  }
+
+  if (auto* registry = extensions::ExtensionRegistry::Get(browser_context)) {
+    if (auto* startup_helper =
+            extensions::RendererStartupHelperFactory::GetForBrowserContext(
+                browser_context)) {
+      std::vector<scoped_refptr<const extensions::Extension>> enabled;
+      for (const auto& ext : registry->enabled_extensions()) {
+        enabled.push_back(ext);
+      }
+      for (const auto& ext : enabled) {
+        startup_helper->OnExtensionUnloaded(*ext);
+      }
+    }
+  }
+
+  if (auto* process_map = extensions::ProcessMap::Get(browser_context)) {
+    for (auto it = content::RenderProcessHost::AllHostsIterator();
+         !it.IsAtEnd(); it.Advance()) {
+      process_map->Remove(it.GetCurrentValue()->GetID());
+    }
+  }
