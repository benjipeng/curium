+  if (!client || !browser_context || !client->IsValidContext(browser_context)) {
+    return;
+  }
+  auto* startup_helper =
+      extensions::RendererStartupHelperFactory::GetForBrowserContext(
+          browser_context);
+  if (!startup_helper) {
+    return;
+  }
+  for (auto it = content::RenderProcessHost::AllHostsIterator(); !it.IsAtEnd();
+       it.Advance()) {
