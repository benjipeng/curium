+#if BUILDFLAG(IS_IOS)
+bool RenderProcessHostImpl::DetachFromBrowserContextForHotSwap() {
+  CHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!run_renderer_in_process() || deleting_soon_ || is_dead_) {
+    return false;
+  }
+  if (GetRenderFrameHostCount() != 0) {
+    return false;
+  }
+  if (!browser_context_ && !storage_partition_impl_) {
+    is_hotswap_detached_ = true;
+    return true;
+  }
+
+  is_hotswap_detached_ = true;
+
+  if (browser_context_) {
+    if (auto* map = static_cast<SiteProcessMap*>(
+            browser_context_->GetUserData(kSiteProcessMapKeyName))) {
+      map->RemoveProcess(this);
+    }
+    const void* const kTrackerKeys[] = {
+        kCommittedSiteProcessCountTrackerKey,
+        kPendingSiteProcessCountTrackerKey,
+        kDelayedShutdownSiteProcessCountTrackerKey,
+        kEmptySiteProcessCountTrackerKey,
+    };
+    for (const void* key : kTrackerKeys) {
+      if (auto* tracker = static_cast<SiteProcessCountTracker*>(
+              browser_context_->GetUserData(key))) {
+        tracker->DetachHostForHotSwap(this);
+      }
+    }
+    UnmatchedServiceWorkerProcessTracker::DetachHostForHotSwap(browser_context_,
+                                                               this);
+  }
+
+  StopTrackingProcessForShutdownDelay();
+
+  if (hot_swap_dom_storage_forwarder_ && storage_partition_impl_) {
+    hot_swap_dom_storage_forwarder_->DetachFromStoragePartition(
+        storage_partition_impl_);
+  }
+  if (storage_partition_impl_) {
+    for (auto receiver_id : dom_storage_receiver_ids_) {
+      storage_partition_impl_->UnbindDomStorage(receiver_id);
+    }
+  }
+  dom_storage_receiver_ids_.clear();
+
+  push_messaging_manager_.reset();
+  file_backed_blob_factory_.reset();
+  permission_service_context_.reset();
+  media_interface_proxy_.reset();
+  file_system_manager_impl_.reset();
+
+  if (io_thread_host_impl_) {
+    io_thread_host_impl_->AsyncCall(
+        &IOThreadHostImpl::ClearBlobRegistryForHotSwap);
+  }
+
+  if (features::IsShaderDiskCacheEnabled(
+          base::CommandLine::ForCurrentProcess())) {
+    if (GetGpuDiskCacheFactorySingleton() && gpu_client_) {
+      gpu_client_->RemoveDiskCacheHandles();
+    }
+  }
