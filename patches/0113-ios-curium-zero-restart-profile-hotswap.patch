+  // launch into this profile opens the exact same "Default" state directory.
+  const base::FilePath target_local_state =
+      new_root.Append(FILE_PATH_LITERAL("Local State"));
+  if (new_state_path.BaseName().value() == FILE_PATH_LITERAL("Default")) {
