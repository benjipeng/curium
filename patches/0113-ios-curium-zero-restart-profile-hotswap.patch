+void PrepareIOSExtensionsForProfileHotSwap(ProfileIOS* profile) {
+  if (content::BrowserThread::CurrentlyOn(content::BrowserThread::UI)) {
+    NSArray<id<CrIOSExtensionPopupHostingV1>>* live_popups =
+        [GetLiveExtensionPopupHosts() allObjects];
