+// static
+int RenderProcessHost::GetTotalRenderFrameHostCountForHotSwap() {
+  CHECK_CURRENTLY_ON(BrowserThread::UI);
+  int total = 0;
+  for (iterator it = AllHostsIterator(); !it.IsAtEnd(); it.Advance()) {
+    total += it.GetCurrentValue()->GetRenderFrameHostCount();
+  }
+  return total;
+}
