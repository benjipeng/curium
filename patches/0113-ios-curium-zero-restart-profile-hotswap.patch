+base::FilePath ResolveProfileStatePathForRoot(
+    const base::FilePath& profile_root) {
+  const base::FilePath local_state_path =
+      profile_root.Append(FILE_PATH_LITERAL("Local State"));
+  std::string contents;
+  constexpr size_t kMaxLocalStateReadBytes = 4 * 1024 * 1024;
+  bool read_ok = false;
+  int read_fd =
+      open(local_state_path.value().c_str(), O_RDONLY | O_CLOEXEC);
+  if (read_fd >= 0) {
+    char buf[4096];
+    read_ok = true;
+    while (contents.size() <= kMaxLocalStateReadBytes) {
+      const ssize_t n = read(read_fd, buf, sizeof(buf));
+      if (n < 0) {
+        if (errno == EINTR) {
+          continue;
+        }
+        read_ok = false;
+        break;
+      }
+      if (n == 0) {
+        break;
+      }
+      if (contents.size() + static_cast<size_t>(n) > kMaxLocalStateReadBytes) {
+        read_ok = false;
+        break;
+      }
+      contents.append(buf, static_cast<size_t>(n));
+    }
+    close(read_fd);
+  }
