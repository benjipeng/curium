+// static
+bool RenderProcessHost::DetachSingleProcessRendererForHotSwap(
+    BrowserContext* outgoing_context) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!run_renderer_in_process()) {
+    for (iterator it = AllHostsIterator(); !it.IsAtEnd(); it.Advance()) {
+      RenderProcessHost* host = it.GetCurrentValue();
+      if (host->GetBrowserContext() == outgoing_context) {
+        if (host->GetRenderFrameHostCount() != 0) {
+          return false;
+        }
+        host->DisableRefCounts();
+      }
+    }
+    return true;
+  }
+
+  if (RenderProcessHostImpl::GetCount() == 0) {
+    return true;
+  }
+  for (iterator it = AllHostsIterator(); !it.IsAtEnd(); it.Advance()) {
+    RenderProcessHostImpl* host =
+        To<RenderProcessHostImpl>(it.GetCurrentValue());
+    if (host->GetBrowserContext() == outgoing_context ||
+        host->GetBrowserContext() == nullptr) {
+      if (!host->DetachFromBrowserContextForHotSwap()) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+// static
+bool RenderProcessHost::RebindSingleProcessRendererForHotSwap(
+    BrowserContext* new_context,
+    StoragePartition* new_storage_partition) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!run_renderer_in_process() || RenderProcessHostImpl::GetCount() == 0) {
+    return true;
+  }
+  if (!new_context || !new_storage_partition) {
+    return false;
+  }
+  auto* partition_impl =
+      static_cast<StoragePartitionImpl*>(new_storage_partition);
+  for (iterator it = AllHostsIterator(); !it.IsAtEnd(); it.Advance()) {
+    RenderProcessHostImpl* host =
+        To<RenderProcessHostImpl>(it.GetCurrentValue());
+    if (!host->RebindToBrowserContextForHotSwap(new_context, partition_impl)) {
+      return false;
+    }
+  }
+  return true;
+}
