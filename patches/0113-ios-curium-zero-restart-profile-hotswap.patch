+// Single-process DOM Storage proxy keeping Blink's singleton StorageController
+// Mojo pipe alive across Build 44 profile hot-swaps while swapping the backend
+// StoragePartitionImpl binding and invalidating cached areas.
+class RenderProcessHostImpl::HotSwapDomStorageForwarder final
+    : public blink::mojom::DomStorage,
+      public blink::mojom::DomStorageClient {
+ public:
+  explicit HotSwapDomStorageForwarder(ChildProcessId process_id)
+      : process_id_(process_id) {}
+  ~HotSwapDomStorageForwarder() override = default;
+
+  void AddFrontendBinding(
+      StoragePartitionImpl* partition,
+      mojo::PendingReceiver<blink::mojom::DomStorage> receiver,
+      mojo::PendingRemote<blink::mojom::DomStorageClient> client) {
+    frontend_receivers_.Add(this, std::move(receiver));
+    if (client.is_valid()) {
+      mojo::Remote<blink::mojom::DomStorageClient> remote;
+      remote.Bind(std::move(client));
+      remote.reset_on_disconnect();
+      frontend_clients_.push_back(std::move(remote));
+    }
+    if (partition && !backend_dom_storage_.is_bound()) {
+      BindBackend(partition);
+    }
+  }
+
+  void DetachFromStoragePartition(StoragePartitionImpl* partition) {
+    if (partition && backend_receiver_id_.has_value()) {
+      partition->UnbindDomStorage(*backend_receiver_id_);
+      backend_receiver_id_.reset();
+    }
+    backend_dom_storage_.reset();
+    backend_client_receiver_.reset();
+    ResetLocalStorageConnections();
+    ResetSessionStorageConnections();
+  }
+
+  void RebindToStoragePartition(StoragePartitionImpl* partition) {
+    if (!partition || frontend_receivers_.empty()) {
+      return;
+    }
+    BindBackend(partition);
+  }
+
+  // blink::mojom::DomStorage:
+  void OpenLocalStorage(
+      const blink::StorageKey& storage_key,
+      const blink::LocalFrameToken& local_frame_token,
+      mojo::PendingReceiver<blink::mojom::StorageArea> receiver) override {
+    if (backend_dom_storage_.is_bound()) {
+      backend_dom_storage_->OpenLocalStorage(storage_key, local_frame_token,
+                                             std::move(receiver));
+    }
+  }
+
+  void BindSessionStorageNamespace(
+      const std::string& namespace_id,
+      mojo::PendingReceiver<blink::mojom::SessionStorageNamespace> receiver)
+      override {
+    if (backend_dom_storage_.is_bound()) {
+      backend_dom_storage_->BindSessionStorageNamespace(namespace_id,
+                                                        std::move(receiver));
+    }
+  }
+
+  void BindSessionStorageArea(
+      const blink::StorageKey& storage_key,
+      const blink::LocalFrameToken& local_frame_token,
+      const std::string& namespace_id,
+      mojo::PendingReceiver<blink::mojom::StorageArea> receiver) override {
+    if (backend_dom_storage_.is_bound()) {
+      backend_dom_storage_->BindSessionStorageArea(
+          storage_key, local_frame_token, namespace_id, std::move(receiver));
+    }
+  }
+
+  // blink::mojom::DomStorageClient:
+  void ResetSessionStorageConnections() override {
+    for (auto& client : frontend_clients_) {
+      if (client.is_bound()) {
+        client->ResetSessionStorageConnections();
+      }
+    }
+  }
+
+  void ResetLocalStorageConnections() override {
+    for (auto& client : frontend_clients_) {
+      if (client.is_bound()) {
+        client->ResetLocalStorageConnections();
+      }
+    }
+  }
+
+ private:
+  void BindBackend(StoragePartitionImpl* partition) {
+    backend_dom_storage_.reset();
+    backend_client_receiver_.reset();
+    backend_receiver_id_ = partition->BindDomStorage(
+        process_id_.GetUnsafeValue(),
+        backend_dom_storage_.BindNewPipeAndPassReceiver(),
+        backend_client_receiver_.BindNewPipeAndPassRemote());
+  }
+
+  const ChildProcessId process_id_;
+  mojo::ReceiverSet<blink::mojom::DomStorage> frontend_receivers_;
+  std::vector<mojo::Remote<blink::mojom::DomStorageClient>> frontend_clients_;
+  mojo::Remote<blink::mojom::DomStorage> backend_dom_storage_;
+  mojo::Receiver<blink::mojom::DomStorageClient> backend_client_receiver_{this};
+  std::optional<mojo::ReceiverId> backend_receiver_id_;
+};
