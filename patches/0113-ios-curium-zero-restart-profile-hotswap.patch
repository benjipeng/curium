+bool RenderProcessHostImpl::RebindToBrowserContextForHotSwap(
+    BrowserContext* browser_context,
+    StoragePartitionImpl* storage_partition_impl) {
+  CHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!run_renderer_in_process() || deleting_soon_ || is_dead_ ||
+      !browser_context || !storage_partition_impl) {
+    return false;
+  }
+  if (!is_hotswap_detached_ && browser_context_ == browser_context &&
+      storage_partition_impl_ == storage_partition_impl) {
+    return true;
+  }
+  CHECK(!browser_context->ShutdownStarted());
+
+  browser_context_ = browser_context;
+  storage_partition_impl_ = storage_partition_impl;
+  is_hotswap_detached_ = false;
+  did_update_renderer_locked_state_ = false;
+
+  ChildProcessSecurityPolicyImpl::GetInstance()->Add(GetID());
+
+  push_messaging_manager_ = std::make_unique<PushMessagingManager>(
+      *this,
+      /* render_frame_id= */ ChildProcessHost::kInvalidUniqueID,
+      base::WrapRefCounted(storage_partition_impl_->GetServiceWorkerContext()));
+
+  if (is_initialized_) {
+    file_system_manager_impl_.reset(new FileSystemManagerImpl(
+        ChildProcessSecurityPolicyImpl::GetInstance()->CreateHandle(GetID()),
+        storage_partition_impl_->GetFileSystemContext(),
+        ChromeBlobStorageContext::GetFor(browser_context_)));
+  }
+
+  if (io_thread_host_impl_) {
+    io_thread_host_impl_->AsyncCall(
+        &IOThreadHostImpl::SetBlobRegistryForHotSwap)
+        .WithArgs(base::WrapRefCounted(
+            storage_partition_impl_->GetBlobRegistry()));
+  }
+
+  if (hot_swap_dom_storage_forwarder_) {
+    hot_swap_dom_storage_forwarder_->RebindToStoragePartition(
+        storage_partition_impl_);
+  }
+
+  if (!browser_context_->IsOffTheRecord() &&
+      features::IsShaderDiskCacheEnabled(
+          base::CommandLine::ForCurrentProcess())) {
+    if (auto* cache_factory = GetGpuDiskCacheFactorySingleton();
+        cache_factory && gpu_client_) {
+      for (const gpu::GpuDiskCacheType type : gpu::kGpuDiskCacheTypes) {
+        auto handle = cache_factory->GetCacheHandle(
+            type, storage_partition_impl_->GetPath().Append(
+                      gpu::GetGpuDiskCacheSubdir(type)));
+        gpu_client_->SetDiskCacheHandle(handle);
+      }
+    }
+  }
+
+  storage_partition_impl_->ResetURLLoaderFactories();
+
+  if (renderer_interface_.is_bound()) {
+    content::cpu_performance::Tier cpu_tier;
+    if (std::optional<int> override =
+            GetContentClient()->browser()->GetCpuPerformanceTierOverride(
+                browser_context_)) {
+      cpu_tier = content::cpu_performance::TierFromInt(*override).value_or(
+          content::cpu_performance::Tier::kUnknown);
+    } else {
+      cpu_tier = content::cpu_performance::GetTier();
+    }
+    const uint64_t trace_id = base::Token::CreateRandom().high();
+    GetRendererInterface()->InitializeRenderer(
+        GetContentClient()->browser()->GetUserAgent(),
+        GetContentClient()->browser()->GetUserAgentMetadata(),
+        storage_partition_impl_->cors_exempt_header_list(),
+        GetContentClient()->browser()->GetOriginTrialsSettings(), cpu_tier,
+        trace_id);
+  }
+
+  return true;
+}
