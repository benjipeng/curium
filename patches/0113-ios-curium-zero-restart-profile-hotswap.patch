+    state.profile_id = std::move(state.staged_profile_id);
+    state.use_custom_profile = state.staged_use_custom_profile;
+    state.configured = true;
+    state.opened = true;
+    new_root = std::move(state.staged_profile_root);
+    new_state_path = std::move(state.staged_state_path);
+
+    state.staged_profile_id.clear();
+    state.staged_use_custom_profile = false;
+    state.staged_same_profile = false;
+    state.staged_lock_fd = -1;
+    state.hotswap_prepared = false;
