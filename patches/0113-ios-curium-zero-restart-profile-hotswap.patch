+          [](base::OnceClosure done) {
+            content::GetIOThreadTaskRunner({})->PostTaskAndReply(
+                FROM_HERE, base::DoNothing(), std::move(done));
+          },
+          std::move(on_flushed)));
+}
+
+void CuriumStopServiceWorkersAndDrainForHotSwap(ProfileIOS* profile,
+                                                base::OnceClosure on_drained) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto drain_after_sw = base::BindOnce(
+      [](base::OnceClosure done) {
+        CuriumFlushIOThreadBarriersForHotSwap(base::BindOnce(
+            [](base::OnceClosure final_done) {
+              base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+                  FROM_HERE, std::move(final_done));
+            },
+            std::move(done)));
+      },
+      std::move(on_drained));
+
+  content::BrowserContext* context =
+      profile ? web::ContentBrowserContext::FromBrowserState(profile) : nullptr;
+  content::StoragePartition* partition =
+      context ? context->GetDefaultStoragePartition() : nullptr;
+  content::ServiceWorkerContext* sw_context =
+      partition ? partition->GetServiceWorkerContext() : nullptr;
+  if (!sw_context) {
+    std::move(drain_after_sw).Run();
+    return;
+  }
+  sw_context->StopAllServiceWorkers(std::move(drain_after_sw));
+}
+
+int CuriumCountLiveRenderFrameHostsForHotSwap() {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  return content::RenderProcessHost::GetTotalRenderFrameHostCountForHotSwap();
+}
+
+bool CuriumDetachSingleProcessRendererForHotSwap(ProfileIOS* profile) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  content::BrowserContext* context =
+      profile ? web::ContentBrowserContext::FromBrowserState(profile) : nullptr;
+  return content::RenderProcessHost::DetachSingleProcessRendererForHotSwap(
+      context);
+}
+
+void CuriumPurgeRendererCachesForHotSwap(base::OnceClosure on_purged) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  blink::curium::PurgeProfileRuntimeCaches(std::move(on_purged));
+}
+
+bool CuriumRebindSingleProcessRendererForHotSwap(ProfileIOS* profile) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!profile) {
+    return false;
+  }
+  content::BrowserContext* context =
+      web::ContentBrowserContext::FromBrowserState(profile);
+  content::StoragePartition* partition =
+      context ? context->GetDefaultStoragePartition() : nullptr;
+  return content::RenderProcessHost::RebindSingleProcessRendererForHotSwap(
+      context, partition);
+}
