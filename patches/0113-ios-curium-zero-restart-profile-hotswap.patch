+    if (state.staged_same_profile) {
+      if (state.lock_fd < 0 && state.staged_lock_fd >= 0) {
+        state.lock_fd = state.staged_lock_fd;
+      } else if (state.staged_lock_fd >= 0) {
+        close(state.staged_lock_fd);
+      }
+    } else {
+      if (state.lock_fd >= 0) {
+        close(state.lock_fd);
+      }
+      state.lock_fd = state.staged_lock_fd;
+    }
