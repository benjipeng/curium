+class CuriumURLLoaderClient final
+    : public base::RefCountedDeleteOnSequence<CuriumURLLoaderClient>,
+      public network::mojom::URLLoaderClient {
+ public:
+  CuriumURLLoaderClient(
+      scoped_refptr<base::SequencedTaskRunner> task_runner,
+      std::unique_ptr<network::ResourceRequest> request,
+      std::unique_ptr<network::PendingSharedURLLoaderFactory> pending_factory,
+      bool include_cookies,
+      bool block_private_network_targets,
+      base::TimeDelta timeout_delta,
+      id<CrIOSNetworkFetchDelegateV1> delegate,
+      dispatch_queue_t callback_queue,
+      void (^on_terminal)(CuriumNetworkFetchTask*))
+      : base::RefCountedDeleteOnSequence<CuriumURLLoaderClient>(task_runner),
+        task_runner_(std::move(task_runner)),
+        initial_request_(std::move(request)),
+        pending_factory_(std::move(pending_factory)),
+        current_url_(initial_request_->url),
+        include_cookies_(include_cookies),
+        block_private_network_targets_(block_private_network_targets),
+        timeout_delta_(timeout_delta),
+        delegate_(delegate),
+        callback_queue_(callback_queue),
+        on_terminal_([on_terminal copy]) {
+    DETACH_FROM_SEQUENCE(sequence_checker_);
+  }
+
+  CuriumURLLoaderClient(const CuriumURLLoaderClient&) = delete;
+  CuriumURLLoaderClient& operator=(const CuriumURLLoaderClient&) = delete;
+
+  void Start(CuriumNetworkFetchTask* task) {
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&CuriumURLLoaderClient::StartOnSequence,
+                       base::WrapRefCounted(this), task));
+  }
+
+  void SetSuspended(bool suspended) {
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&CuriumURLLoaderClient::SetSuspendedOnSequence,
+                       base::WrapRefCounted(this), suspended));
+  }
+
+  void Cancel(int net_error, NSString* reason) {
+    cancelled_.store(true, std::memory_order_release);
+    NSString* reason_copy = [reason copy];
+    task_runner_->PostTask(
+        FROM_HERE,
+        base::BindOnce(&CuriumURLLoaderClient::CancelOnSequence,
+                       base::WrapRefCounted(this), net_error, reason_copy));
+  }
+
+  bool IsCancelled() const {
+    return cancelled_.load(std::memory_order_acquire);
+  }
+
+ private:
+  friend class base::RefCountedDeleteOnSequence<CuriumURLLoaderClient>;
+  friend class base::DeleteHelper<CuriumURLLoaderClient>;
+
+  ~CuriumURLLoaderClient() override {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    TeardownMojoOnSequence();
+  }
+
+  // network::mojom::URLLoaderClient:
+  void OnReceiveEarlyHints(network::mojom::EarlyHintsPtr) override {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  }
+
+  void OnReceiveResponse(
+      network::mojom::URLResponseHeadPtr response_head,
+      mojo::ScopedDataPipeConsumerHandle body,
+      std::optional<mojo_base::BigBuffer>) override {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (finished_ || IsCancelled()) {
+      return;
+    }
+    if (block_private_network_targets_ && response_head &&
+        IsBlockedResponseEndpoint(*response_head)) {
+      FinishOnSequence(MakeBlockedPrivateTargetError(
+          @"Response from private network target blocked."));
+      return;
+    }
+    NSURL* final_ns_url = net::NSURLWithGURL(current_url_);
+    if (!final_ns_url) {
+      FinishOnSequence(
+          MakeNetError(net::ERR_INVALID_URL, @"Invalid final response URL."));
+      return;
+    }
+
+    const NSInteger status_code =
+        (response_head && response_head->headers)
+            ? response_head->headers->response_code()
+            : 200;
+    const int64_t expected_length =
+        (response_head && response_head->content_length >= 0)
+            ? response_head->content_length
+            : -1;
+    NSDictionary<NSString*, NSString*>* headers_dict =
+        BuildNormalizedResponseHeaders(
+            response_head ? response_head->headers.get() : nullptr);
+
+    received_response_ = true;
+    body_pipe_ = std::move(body);
+    if (!body_pipe_.is_valid()) {
+      body_complete_ = true;
+    }
+    awaiting_response_dispatch_ = true;
+    ArmTimeoutTimer();
+
+    scoped_refptr<CuriumURLLoaderClient> self_ref(this);
+    id<CrIOSNetworkFetchDelegateV1> delegate = delegate_;
+    CuriumNetworkFetchTask* task = active_task_;
+    scoped_refptr<base::SequencedTaskRunner> runner = task_runner_;
+    dispatch_async(callback_queue_, ^{
+      if (!self_ref->IsCancelled() && delegate && task) {
+        [delegate networkFetchTask:task
+                didReceiveResponse:status_code
+                          finalURL:final_ns_url
+                    expectedLength:expected_length
+                   responseHeaders:headers_dict];
+      }
+      runner->PostTask(
+          FROM_HERE,
+          base::BindOnce(&CuriumURLLoaderClient::OnResponseDeliveredOnSequence,
+                         self_ref));
+    });
+  }
+
+  void OnReceiveRedirect(
+      const net::RedirectInfo& redirect_info,
+      network::mojom::URLResponseHeadPtr response_head) override {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (finished_ || IsCancelled()) {
+      return;
+    }
+    ++redirect_count_;
+    if (redirect_count_ > kMaxRedirects) {
+      FinishOnSequence(
+          MakeNetError(net::ERR_TOO_MANY_REDIRECTS, @"Too many redirects."));
+      return;
+    }
+    if (!redirect_info.new_url.is_valid() ||
+        !redirect_info.new_url.SchemeIsHTTPOrHTTPS()) {
+      FinishOnSequence(MakeNetError(
+          net::ERR_UNSAFE_REDIRECT,
+          @"Redirect to unsupported URL scheme blocked."));
+      return;
+    }
+    if (block_private_network_targets_) {
+      if (response_head && IsBlockedResponseEndpoint(*response_head)) {
+        FinishOnSequence(MakeBlockedPrivateTargetError(
+            @"Redirect response from private network target blocked."));
+        return;
+      }
+      if (IsBlockedTargetURL(redirect_info.new_url)) {
+        FinishOnSequence(MakeBlockedPrivateTargetError(
+            @"Redirect to private network target blocked."));
+        return;
+      }
+    }
+
+    NSURL* new_ns_url = net::NSURLWithGURL(redirect_info.new_url);
+    if (!new_ns_url) {
+      FinishOnSequence(
+          MakeNetError(net::ERR_INVALID_URL, @"Invalid redirect URL."));
+      return;
+    }
+
+    const NSInteger status_code =
+        redirect_info.status_code > 0
+            ? redirect_info.status_code
+            : ((response_head && response_head->headers)
+                   ? response_head->headers->response_code()
+                   : 302);
+    NSDictionary<NSString*, NSString*>* headers_dict =
+        BuildNormalizedResponseHeaders(
+            response_head ? response_head->headers.get() : nullptr);
+
+    pending_redirect_url_ = redirect_info.new_url;
+    awaiting_redirect_decision_ = true;
+    ArmTimeoutTimer();
+
+    scoped_refptr<CuriumURLLoaderClient> self_ref(this);
+    id<CrIOSNetworkFetchDelegateV1> delegate = delegate_;
+    CuriumNetworkFetchTask* task = active_task_;
+    scoped_refptr<base::SequencedTaskRunner> runner = task_runner_;
+    auto handled = std::make_shared<std::atomic<bool>>(false);
+    dispatch_async(callback_queue_, ^{
+      if (self_ref->IsCancelled() || !delegate || !task) {
+        return;
+      }
+      [delegate networkFetchTask:task
+             willPerformRedirect:new_ns_url
+                      statusCode:status_code
+                 responseHeaders:headers_dict
+                 decisionHandler:^(
+                     BOOL allowRedirect,
+                     NSDictionary<NSString*, NSString*>* _Nullable
+                         modifiedHeaders) {
+                   if (handled->exchange(true, std::memory_order_acq_rel)) {
+                     return;
+                   }
+                   NSDictionary<NSString*, NSString*>* headers_copy =
+                       modifiedHeaders ? [modifiedHeaders copy] : nil;
+                   runner->PostTask(
+                       FROM_HERE,
+                       base::BindOnce(
+                           &CuriumURLLoaderClient::OnRedirectDecisionOnSequence,
+                           self_ref, allowRedirect == YES, headers_copy));
+                 }];
+    });
+  }
+
+  void OnUploadProgress(int64_t,
+                        int64_t,
+                        OnUploadProgressCallback ack_callback) override {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    std::move(ack_callback).Run();
+  }
+
+  void OnTransferSizeUpdated(int32_t) override {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  }
+
+  void OnComplete(const network::URLLoaderCompletionStatus& status) override {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (finished_ || IsCancelled()) {
+      return;
+    }
+    has_completion_status_ = true;
+    completion_status_ = status;
+    if (!received_response_ || status.error_code != net::OK) {
+      if (body_watcher_) {
+        body_watcher_->Cancel();
+        body_watcher_.reset();
+      }
+      body_pipe_.reset();
+      body_complete_ = true;
+    }
+    MaybeFinalizeOnSequence();
+  }
+
+  void StartOnSequence(CuriumNetworkFetchTask* task) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    active_task_ = task;
+    if (finished_) {
+      return;
+    }
+    if (IsCancelled()) {
+      FinishOnSequence(MakeCancelledError(@"Fetch task cancelled."));
+      return;
+    }
+    if (block_private_network_targets_ && IsBlockedTargetURL(current_url_)) {
+      FinishOnSequence(MakeBlockedPrivateTargetError(
+          @"Request to private network target blocked."));
+      return;
+    }
+    if (!pending_factory_ || !initial_request_) {
+      FinishOnSequence(MakeNetError(
+          net::ERR_FAILED, @"Network loader factory unavailable."));
+      return;
+    }
+
+    loader_factory_ =
+        network::SharedURLLoaderFactory::Create(std::move(pending_factory_));
+    if (!loader_factory_) {
+      FinishOnSequence(MakeNetError(
+          net::ERR_FAILED, @"Failed to bind SharedURLLoaderFactory."));
+      return;
+    }
+
+    const uint32_t load_options =
+        include_cookies_ ? network::mojom::kURLLoadOptionNone
+                         : network::mojom::kURLLoadOptionBlockAllCookies;
+    loader_factory_->CreateLoaderAndStart(
+        url_loader_.BindNewPipeAndPassReceiver(task_runner_),
+        /*request_id=*/0, load_options, *initial_request_,
+        client_receiver_.BindNewPipeAndPassRemote(task_runner_),
+        net::MutableNetworkTrafficAnnotationTag(
+            kCuriumNetworkFetchTrafficAnnotation));
+    initial_request_.reset();
+    client_receiver_.set_disconnect_handler(
+        base::BindOnce(&CuriumURLLoaderClient::OnMojoDisconnectOnSequence,
+                       base::Unretained(this)));
+    ArmTimeoutTimer();
+  }
+
+  void OnRedirectDecisionOnSequence(
+      bool allow,
+      NSDictionary<NSString*, NSString*>* modified_headers) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (finished_ || IsCancelled() || !awaiting_redirect_decision_ ||
+        !url_loader_.is_bound()) {
+      return;
+    }
+    awaiting_redirect_decision_ = false;
+    if (!allow) {
+      FinishOnSequence(MakeCancelledError(@"Redirect cancelled by delegate."));
+      return;
+    }
+
+    network::HttpRequestHeadersUpdateParams headers_update_params;
+    const url::Origin old_origin = url::Origin::Create(current_url_);
+    const url::Origin new_origin = url::Origin::Create(pending_redirect_url_);
+    if (!old_origin.IsSameOriginWith(new_origin)) {
+      headers_update_params.RemoveHeader(
+          net::HttpRequestHeaders::kAuthorization);
+      headers_update_params.RemoveHeader(
+          net::HttpRequestHeaders::kProxyAuthorization);
+      if (current_url_.SchemeIs("https") &&
+          !pending_redirect_url_.SchemeIs("https")) {
+        headers_update_params.RemoveHeader(net::HttpRequestHeaders::kOrigin);
+        headers_update_params.RemoveHeader(net::HttpRequestHeaders::kReferer);
+      }
+    }
+
+    if (modified_headers) {
+      for (id raw_key in modified_headers) {
+        if (![raw_key isKindOfClass:[NSString class]]) {
+          continue;
+        }
+        const std::string key = base::SysNSStringToUTF8((NSString*)raw_key);
+        if (!net::HttpUtil::IsValidHeaderName(key)) {
+          continue;
+        }
+        id raw_value = modified_headers[raw_key];
+        if (![raw_value isKindOfClass:[NSString class]] ||
+            [(NSString*)raw_value length] == 0) {
+          headers_update_params.RemoveHeader(key);
+          continue;
+        }
+        const std::string value = base::SysNSStringToUTF8((NSString*)raw_value);
+        if (net::HttpUtil::IsValidHeaderValue(value) &&
+            network::IsRequestHeaderSafe(key, value)) {
+          headers_update_params.SetHeader(key, value);
+        }
+      }
+    }
+
+    current_url_ = pending_redirect_url_;
+    pending_redirect_url_ = GURL();
+    ArmTimeoutTimer();
+    url_loader_->FollowRedirect(std::move(headers_update_params), std::nullopt);
+  }
+
+  void OnResponseDeliveredOnSequence() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    awaiting_response_dispatch_ = false;
+    if (finished_ || IsCancelled()) {
+      return;
+    }
+    if (has_completion_status_ && completion_status_.error_code != net::OK) {
+      if (body_watcher_) {
+        body_watcher_->Cancel();
+        body_watcher_.reset();
+      }
+      body_pipe_.reset();
+      body_complete_ = true;
+      MaybeFinalizeOnSequence();
+      return;
+    }
+    if (body_pipe_.is_valid() && !body_complete_) {
+      body_watcher_ = std::make_unique<mojo::SimpleWatcher>(
+          FROM_HERE, mojo::SimpleWatcher::ArmingPolicy::MANUAL, task_runner_);
+      const MojoResult watch_result = body_watcher_->Watch(
+          body_pipe_.get(),
+          MOJO_HANDLE_SIGNAL_READABLE | MOJO_HANDLE_SIGNAL_PEER_CLOSED,
+          MOJO_WATCH_CONDITION_SATISFIED,
+          base::BindRepeating(&CuriumURLLoaderClient::OnBodyPipeReadyOnSequence,
+                              base::Unretained(this)));
+      if (watch_result != MOJO_RESULT_OK) {
+        body_watcher_.reset();
+        body_pipe_.reset();
+        body_complete_ = true;
+        FinishOnSequence(MakeNetError(
+            net::ERR_FAILED, @"Failed to watch response body data pipe."));
+        return;
+      }
+      if (!suspended_) {
+        ReadBodyOnSequence();
+      }
+      return;
+    }
+    body_complete_ = true;
+    MaybeFinalizeOnSequence();
+  }
+
+  void OnBodyPipeReadyOnSequence(MojoResult result,
+                                 const mojo::HandleSignalsState&) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (finished_ || IsCancelled()) {
+      return;
+    }
+    if (result == MOJO_RESULT_CANCELLED ||
+        result == MOJO_RESULT_FAILED_PRECONDITION) {
+      if (body_watcher_) {
+        body_watcher_->Cancel();
+        body_watcher_.reset();
+      }
+      body_pipe_.reset();
+      body_complete_ = true;
+      MaybeFinalizeOnSequence();
+      return;
+    }
+    if (result != MOJO_RESULT_OK) {
+      FinishOnSequence(MakeNetError(
+          net::ERR_FAILED, @"Response body data pipe signaled error."));
+      return;
+    }
+    if (suspended_ || in_flight_chunks_ >= kMaxInFlightChunks) {
+      return;
+    }
+    ReadBodyOnSequence();
+  }
+
+  void ReadBodyOnSequence() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (finished_ || IsCancelled() || suspended_ || body_complete_ ||
+        !body_pipe_.is_valid()) {
+      return;
+    }
+    while (!suspended_ && in_flight_chunks_ < kMaxInFlightChunks &&
+           body_pipe_.is_valid()) {
+      base::span<const uint8_t> buffer;
+      const MojoResult read_result =
+          body_pipe_->BeginReadData(MOJO_BEGIN_READ_DATA_FLAG_NONE, buffer);
+      if (read_result == MOJO_RESULT_OK) {
+        if (buffer.empty()) {
+          body_pipe_->EndReadData(0);
+          if (body_watcher_) {
+            body_watcher_->ArmOrNotify();
+          }
+          return;
+        }
+        const size_t bytes_to_read = std::min(buffer.size(), kMaxChunkBytes);
+        NSData* chunk = [NSData dataWithBytes:buffer.data()
+                                       length:bytes_to_read];
+        const MojoResult end_result = body_pipe_->EndReadData(bytes_to_read);
+        if (end_result != MOJO_RESULT_OK) {
+          FinishOnSequence(MakeNetError(
+              net::ERR_FAILED, @"Failed to finalize response body read."));
+          return;
+        }
+        ++in_flight_chunks_;
+        ArmTimeoutTimer();
+
+        scoped_refptr<CuriumURLLoaderClient> self_ref(this);
+        id<CrIOSNetworkFetchDelegateV1> delegate = delegate_;
+        CuriumNetworkFetchTask* task = active_task_;
+        scoped_refptr<base::SequencedTaskRunner> runner = task_runner_;
+        dispatch_async(callback_queue_, ^{
+          if (!self_ref->IsCancelled() && delegate && task) {
+            [delegate networkFetchTask:task didReceiveData:chunk];
+          }
+          runner->PostTask(
+              FROM_HERE,
+              base::BindOnce(&CuriumURLLoaderClient::OnChunkDeliveredOnSequence,
+                             self_ref));
+        });
+      } else if (read_result == MOJO_RESULT_SHOULD_WAIT) {
+        if (body_watcher_) {
+          body_watcher_->ArmOrNotify();
+        }
+        return;
+      } else if (read_result == MOJO_RESULT_FAILED_PRECONDITION) {
+        if (body_watcher_) {
+          body_watcher_->Cancel();
+          body_watcher_.reset();
+        }
+        body_pipe_.reset();
+        body_complete_ = true;
+        MaybeFinalizeOnSequence();
+        return;
+      } else {
+        FinishOnSequence(MakeNetError(
+            net::ERR_FAILED, @"Response body data pipe read error."));
+        return;
+      }
+    }
+  }
+
+  void OnChunkDeliveredOnSequence() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    DCHECK_GT(in_flight_chunks_, 0);
+    --in_flight_chunks_;
+    if (finished_ || IsCancelled()) {
+      return;
+    }
+    if (body_complete_) {
+      MaybeFinalizeOnSequence();
+      return;
+    }
+    if (!suspended_ && in_flight_chunks_ < kMaxInFlightChunks &&
+        body_pipe_.is_valid()) {
+      ReadBodyOnSequence();
+    }
+  }
+
+  void SetSuspendedOnSequence(bool suspended) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (finished_ || IsCancelled() || suspended_ == suspended) {
+      return;
+    }
+    suspended_ = suspended;
+    if (suspended_) {
+      timeout_timer_.Stop();
+      return;
+    }
+    ArmTimeoutTimer();
+    if (!awaiting_response_dispatch_ && !body_complete_ &&
+        body_pipe_.is_valid() && in_flight_chunks_ < kMaxInFlightChunks) {
+      ReadBodyOnSequence();
+    }
+  }
+
+  void CancelOnSequence(int net_error, NSString* reason) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (finished_) {
+      return;
+    }
+    NSError* error = (net_error == net::ERR_ABORTED)
+                         ? MakeCancelledError(reason)
+                         : MakeNetError(net_error, reason);
+    FinishOnSequence(error);
+  }
+
+  void OnMojoDisconnectOnSequence() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (finished_ || IsCancelled() || has_completion_status_) {
+      return;
+    }
+    FinishOnSequence(MakeNetError(
+        net::ERR_FAILED, @"Network service loader disconnected unexpectedly."));
+  }
+
+  void OnTimeoutOnSequence() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (finished_ || IsCancelled()) {
+      return;
+    }
+    cancelled_.store(true, std::memory_order_release);
+    FinishOnSequence(MakeTimeoutError());
+  }
+
+  void ArmTimeoutTimer() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (finished_ || IsCancelled() || suspended_ ||
+        timeout_delta_ <= base::TimeDelta()) {
+      timeout_timer_.Stop();
+      return;
+    }
+    timeout_timer_.Start(
+        FROM_HERE, timeout_delta_,
+        base::BindOnce(&CuriumURLLoaderClient::OnTimeoutOnSequence,
+                       base::Unretained(this)));
+  }
+
+  void MaybeFinalizeOnSequence() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (finished_ || IsCancelled() || awaiting_response_dispatch_ ||
+        !has_completion_status_ || !body_complete_ || in_flight_chunks_ > 0) {
+      return;
+    }
+    NSError* error =
+        completion_status_.error_code == net::OK
+            ? nil
+            : MakeNetError(completion_status_.error_code, nil);
+    FinishOnSequence(error);
+  }
+
+  void TeardownMojoOnSequence() {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    timeout_timer_.Stop();
+    if (body_watcher_) {
+      body_watcher_->Cancel();
+      body_watcher_.reset();
+    }
+    body_pipe_.reset();
+    client_receiver_.reset();
+    url_loader_.reset();
+    loader_factory_.reset();
+    pending_factory_.reset();
+    initial_request_.reset();
+  }
+
+  void FinishOnSequence(NSError* error) {
+    DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+    if (finished_) {
+      return;
+    }
+    finished_ = true;
+    cancelled_.store(true, std::memory_order_release);
+    TeardownMojoOnSequence();
+
+    id<CrIOSNetworkFetchDelegateV1> delegate = delegate_;
+    delegate_ = nil;
+    CuriumNetworkFetchTask* task = active_task_;
+    active_task_ = nil;
+    void (^on_terminal)(CuriumNetworkFetchTask*) = on_terminal_;
+    on_terminal_ = nil;
+    dispatch_queue_t queue = callback_queue_;
+    callback_queue_ = nil;
+
+    if (delegate && task && queue) {
+      dispatch_async(queue, ^{
+        [delegate networkFetchTask:task didCompleteWithError:error];
+      });
+    }
+    if (on_terminal && task) {
+      dispatch_async(dispatch_get_main_queue(), ^{
+        on_terminal(task);
+      });
+    }
+  }
+
+  SEQUENCE_CHECKER(sequence_checker_);
+
+  scoped_refptr<base::SequencedTaskRunner> task_runner_;
+  std::unique_ptr<network::ResourceRequest> initial_request_;
+  std::unique_ptr<network::PendingSharedURLLoaderFactory> pending_factory_;
+  GURL current_url_;
+  GURL pending_redirect_url_;
+  const bool include_cookies_;
+  const bool block_private_network_targets_;
+  const base::TimeDelta timeout_delta_;
+
+  std::atomic<bool> cancelled_{false};
+  bool finished_ = false;
+  bool suspended_ = false;
+  bool awaiting_redirect_decision_ = false;
+  bool awaiting_response_dispatch_ = false;
+  bool received_response_ = false;
+  bool body_complete_ = false;
+  bool has_completion_status_ = false;
+  int redirect_count_ = 0;
+  int in_flight_chunks_ = 0;
+  network::URLLoaderCompletionStatus completion_status_;
+
+  id<CrIOSNetworkFetchDelegateV1> delegate_ = nil;
+  CuriumNetworkFetchTask* active_task_ = nil;
+  dispatch_queue_t callback_queue_ = nil;
+  void (^on_terminal_)(CuriumNetworkFetchTask*) = nil;
+
+  // Ordered so reverse destruction stops timer and cancels watcher before
+  // closing the data pipe or Mojo endpoints.
+  scoped_refptr<network::SharedURLLoaderFactory> loader_factory_;
+  mojo::Remote<network::mojom::URLLoader> url_loader_;
+  mojo::Receiver<network::mojom::URLLoaderClient> client_receiver_{this};
+  mojo::ScopedDataPipeConsumerHandle body_pipe_;
+  std::unique_ptr<mojo::SimpleWatcher> body_watcher_;
+  base::OneShotTimer timeout_timer_;
+};
+
+std::unique_ptr<network::ResourceRequest> BuildResourceRequest(
+    CrIOSNetworkFetchRequestV1* request) {
+  if (!request || !request.URL) {
+    return nullptr;
+  }
+  const GURL gurl = net::GURLWithNSURL(request.URL);
+  if (!gurl.is_valid() || !gurl.SchemeIsHTTPOrHTTPS()) {
+    return nullptr;
+  }
+
+  std::string method = net::HttpRequestHeaders::kGetMethod;
+  if (request.HTTPMethod.length > 0) {
+    method = base::ToUpperASCII(base::SysNSStringToUTF8(request.HTTPMethod));
+  }
+  if (method != net::HttpRequestHeaders::kGetMethod &&
+      method != net::HttpRequestHeaders::kHeadMethod) {
+    return nullptr;
+  }
+
+  auto resource_request = std::make_unique<network::ResourceRequest>();
+  resource_request->url = gurl;
+  resource_request->method = method;
+  resource_request->mode = network::mojom::RequestMode::kNoCors;
+  resource_request->redirect_mode = network::mojom::RedirectMode::kFollow;
+  resource_request->destination = network::mojom::RequestDestination::kEmpty;
+  resource_request->priority = net::MEDIUM;
+  // Bypass HTTP cache so parallel multi-lane Range requests do not serialize
+  // on Chromium's single-writer HttpCache entry lock or evict web assets.
+  resource_request->load_flags = net::LOAD_DISABLE_CACHE;
+
+  if (request.includeCookies) {
+    resource_request->credentials_mode =
+        network::mojom::CredentialsMode::kInclude;
+    GURL top_url;
+    if (request.isolationTopFrameURL) {
+      GURL candidate = net::GURLWithNSURL(request.isolationTopFrameURL);
+      if (candidate.is_valid() && candidate.SchemeIsHTTPOrHTTPS()) {
+        top_url = std::move(candidate);
+      }
+    }
+    const GURL& isolation_source = top_url.is_valid() ? top_url : gurl;
+    const url::Origin top_origin = url::Origin::Create(isolation_source);
+    const url::Origin frame_origin = top_origin;
+    const net::SiteForCookies site_for_cookies =
+        net::SiteForCookies::FromUrl(isolation_source);
+    resource_request->site_for_cookies = site_for_cookies;
+    resource_request->trusted_params.emplace();
+    resource_request->trusted_params->isolation_info =
+        net::IsolationInfo::Create(net::IsolationInfo::RequestType::kOther,
+                                   top_origin, frame_origin, site_for_cookies);
+  } else {
+    resource_request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    resource_request->site_for_cookies = net::SiteForCookies();
+    resource_request->trusted_params.emplace();
+    resource_request->trusted_params->isolation_info =
+        net::IsolationInfo::CreateTransient(/*nonce=*/std::nullopt);
+  }
+
+  if (request.headers) {
+    for (id raw_key in request.headers) {
+      if (![raw_key isKindOfClass:[NSString class]]) {
+        continue;
+      }
+      id raw_value = request.headers[raw_key];
+      if (![raw_value isKindOfClass:[NSString class]]) {
+        continue;
+      }
+      const std::string key = base::SysNSStringToUTF8((NSString*)raw_key);
+      const std::string value = base::SysNSStringToUTF8((NSString*)raw_value);
+      if (!net::HttpUtil::IsValidHeaderName(key) ||
+          !net::HttpUtil::IsValidHeaderValue(value)) {
+        continue;
+      }
+      if (base::EqualsCaseInsensitiveASCII(key,
+                                           net::HttpRequestHeaders::kReferer)) {
+        const GURL ref_url(value);
+        if (ref_url.is_valid() && ref_url.SchemeIsHTTPOrHTTPS()) {
+          resource_request->referrer = ref_url;
+          resource_request->referrer_policy = net::ReferrerPolicy::
+              CLEAR_ON_TRANSITION_FROM_SECURE_TO_INSECURE;
+        }
+        continue;
+      }
+      if (network::IsRequestHeaderSafe(key, value)) {
+        resource_request->headers.SetHeader(key, value);
+      }
+    }
+  }
+
+  return resource_request;
+}
+
+}  // namespace
+
+@implementation CrIOSNetworkFetchRequestV1
+
+- (instancetype)init {
+  self = [super init];
+  if (self) {
+    _HTTPMethod = @"GET";
+    _includeCookies = YES;
+    _blockPrivateNetworkTargets = YES;
+    _timeoutInterval = 60.0;
+  }
+  return self;
+}
+
+@end
+
+@implementation CuriumNetworkFetchTask {
+  scoped_refptr<CuriumURLLoaderClient> _core;
+}
+
+- (nullable instancetype)
+    initWithRequest:(CrIOSNetworkFetchRequestV1*)request
+     pendingFactory:
+         (std::unique_ptr<network::PendingSharedURLLoaderFactory>)pendingFactory
+           delegate:(id<CrIOSNetworkFetchDelegateV1>)delegate
+      callbackQueue:(dispatch_queue_t)callbackQueue
+         onTerminal:(nullable void (^)(CuriumNetworkFetchTask*))onTerminal {
+  if (!request || !pendingFactory || !delegate || !callbackQueue) {
+    return nil;
+  }
+  std::unique_ptr<network::ResourceRequest> resource_request =
+      BuildResourceRequest(request);
+  if (!resource_request) {
+    return nil;
+  }
+
+  self = [super init];
+  if (self) {
+    const NSTimeInterval raw_timeout = request.timeoutInterval;
+    const base::TimeDelta timeout_delta =
+        (std::isfinite(raw_timeout) && raw_timeout > 0.0)
+            ? base::Seconds(raw_timeout)
+            : base::TimeDelta();
+    scoped_refptr<base::SequencedTaskRunner> task_runner =
+        base::ThreadPool::CreateSequencedTaskRunner(
+            {base::TaskPriority::USER_VISIBLE,
+             base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN});
+    _core = base::MakeRefCounted<CuriumURLLoaderClient>(
+        std::move(task_runner), std::move(resource_request),
+        std::move(pendingFactory), request.includeCookies == YES,
+        request.blockPrivateNetworkTargets == YES, timeout_delta, delegate,
+        callbackQueue, onTerminal);
+    _core->Start(self);
+  }
+  return self;
+}
+
+- (void)dealloc {
+  if (_core) {
+    _core->Cancel(net::ERR_ABORTED, @"Fetch task deallocated.");
+  }
+}
+
+- (void)setSuspended:(BOOL)suspended {
+  if (_core) {
+    _core->SetSuspended(suspended == YES);
+  }
+}
+
+- (void)cancel {
+  if (_core) {
+    _core->Cancel(net::ERR_ABORTED, @"Fetch task cancelled.");
+  }
+}
+
+- (void)invalidate {
+  if (_core) {
+    _core->Cancel(net::ERR_ABORTED, @"Fetch task invalidated.");
+  }
+}
+
+@end
