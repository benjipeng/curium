+    startFetchRequest:(CrIOSNetworkFetchRequestV1*)request
+             delegate:(id<CrIOSNetworkFetchDelegateV1>)delegate
+        callbackQueue:(dispatch_queue_t)callbackQueue {
+  CHECK([NSThread isMainThread]);
+  if (_isShutdown || !_browser || !request || !delegate || !callbackQueue) {
+    return nil;
+  }
+  content::BrowserContext* context =
+      web::ContentBrowserContext::FromBrowserState(_browser->GetProfile());
+  content::StoragePartition* partition =
+      context ? context->GetDefaultStoragePartition() : nullptr;
+  scoped_refptr<network::SharedURLLoaderFactory> factory =
+      partition ? partition->GetURLLoaderFactoryForBrowserProcess() : nullptr;
+  std::unique_ptr<network::PendingSharedURLLoaderFactory> pending_factory =
+      factory ? factory->Clone() : nullptr;
+  if (!pending_factory) {
+    return nil;
+  }
+
+  __weak CuriumBrowserHost* weakSelf = self;
+  CuriumNetworkFetchTask* task = [[CuriumNetworkFetchTask alloc]
+      initWithRequest:request
+       pendingFactory:std::move(pending_factory)
+             delegate:delegate
+        callbackQueue:callbackQueue
+           onTerminal:^(CuriumNetworkFetchTask* finished) {
+             CuriumBrowserHost* strongSelf = weakSelf;
+             if (strongSelf) {
+               [strongSelf->_activeFetches removeObjectIdenticalTo:finished];
+             }
