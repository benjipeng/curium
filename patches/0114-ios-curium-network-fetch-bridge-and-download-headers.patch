+- (BOOL)discardTabWithID:(NSString*)tabID {
+  CHECK([NSThread isMainThread]);
+  if (_isShutdown || !_browser || tabID.length == 0) {
+    return NO;
+  }
+  if (!base::FeatureList::IsEnabled(content::features::kWebContentsDiscard)) {
+    return NO;
+  }
+  WebStateList* list = _browser->GetWebStateList();
+  if (!list || list->IsMutating()) {
+    return NO;
+  }
+  CuriumTabHost* tab = [self tabHostForTabID:tabID];
+  web::WebState* ws = tab ? tab.webState : nullptr;
+  if (!ws || ws == list->GetActiveWebState() || ws->IsVisible() ||
+      ws->IsBeingDestroyed() || !ws->IsRealized() ||
+      ws->GetNavigationItemCount() <= 0) {
+    return NO;
+  }
+  content::WebContents* wc =
+      static_cast<web::ContentWebState*>(ws)->GetWebContents();
+  if (!wc || wc->IsBeingDestroyed() || wc->WasDiscarded() ||
+      wc->IsCurrentlyAudible() || wc->GetCurrentlyPlayingVideoCount() > 0 ||
+      wc->HasPictureInPictureVideo() || wc->HasPictureInPictureDocument() ||
+      wc->IsBeingCaptured() ||
+      wc->HasUncommittedNavigationInPrimaryMainFrame()) {
+    return NO;
+  }
+  wc->Discard(base::DoNothing());
+  return wc->WasDiscarded() ? YES : NO;
+}
