+      callbackQueue:(dispatch_queue_t)callbackQueue
+         onTerminal:(nullable void (^)(CuriumNetworkFetchTask*))onTerminal
+    NS_DESIGNATED_INITIALIZER;
+- (instancetype)init NS_UNAVAILABLE;
+
+// Cancels the underlying Chromium URLLoader and tears down state cleanly.
+// Safe to invoke from any thread, including CuriumBrowserHost -shutdown.
+- (void)invalidate;
+
+@end
+
+NS_ASSUME_NONNULL_END
+
