+NSError* MakeCancelledError(NSString* description) {
+  return [NSError
+      errorWithDomain:NSCocoaErrorDomain
+                 code:NSUserCancelledError
+             userInfo:@{
+               NSLocalizedDescriptionKey : description ?: @"Fetch cancelled.",
+               @"netError" : @(net::ERR_ABORTED),
+             }];
+}
+
+NSError* MakeTimeoutError() {
+  return [NSError errorWithDomain:NSURLErrorDomain
+                             code:NSURLErrorTimedOut
+                         userInfo:@{
+                           NSLocalizedDescriptionKey :
+                               @"Network fetch request timed out.",
+                           @"netError" : @(net::ERR_TIMED_OUT),
+                         }];
+}
+
+NSError* MakeNetError(int net_error, NSString* description) {
+  NSString* message = description;
+  if (!message) {
+    NSString* short_name =
+        base::SysUTF8ToNSString(net::ErrorToShortString(net_error));
+    message =
+        short_name.length > 0
+            ? [NSString stringWithFormat:@"Network fetch failed (%@, %d).",
+                                         short_name, net_error]
+            : [NSString
+                  stringWithFormat:@"Network fetch failed (net error %d).",
+                                   net_error];
+  }
+  return [NSError errorWithDomain:kCuriumNetworkFetchErrorDomain
+                             code:net_error
+                         userInfo:@{
+                           NSLocalizedDescriptionKey : message,
+                           @"netError" : @(net_error),
+                         }];
+}
+
+NSError* MakeBlockedPrivateTargetError(NSString* description) {
+  return MakeNetError(net::ERR_BLOCKED_BY_CLIENT, description);
+}
+
+bool IsBlockedPrivateIP(const net::IPAddress& address) {
+  if (!address.IsValid()) {
+    return false;
+  }
+  const net::IPAddress normalized =
+      address.IsIPv4MappedIPv6() ? net::ConvertIPv4MappedIPv6ToIPv4(address)
+                                 : address;
+  return normalized.IsZero() || normalized.IsLoopback() ||
+         normalized.IsLinkLocal() || normalized.IsMulticast() ||
+         normalized.IsUniqueLocalIPv6() || !normalized.IsPubliclyRoutable();
+}
+
+bool IsBlockedTargetURL(const GURL& url) {
+  if (!url.is_valid() || !url.SchemeIsHTTPOrHTTPS()) {
+    return true;
+  }
+  if (net::IsLocalhost(url)) {
+    return true;
+  }
+  net::IPAddress literal_ip;
+  if (net::ParseURLHostnameToAddress(url.host(), &literal_ip)) {
+    return IsBlockedPrivateIP(literal_ip);
+  }
+  return false;
+}
+
+bool IsBlockedResponseEndpoint(const network::mojom::URLResponseHead& head) {
+  // When a request is routed through a user-configured proxy chain,
+  // `remote_endpoint` is the proxy's socket address rather than the origin
+  // server's resolved IP. Only enforce post-DNS IP blocking on direct sockets.
+  if (head.proxy_chain.IsValid() && !head.proxy_chain.is_direct()) {
+    return false;
+  }
+  return IsBlockedPrivateIP(head.remote_endpoint.address());
+}
+
+NSString* HeaderValueToNSString(const std::string& value) {
+  if (NSString* utf8 = base::SysUTF8ToNSString(value)) {
+    return utf8;
+  }
+  return [[NSString alloc] initWithBytes:value.data()
+                                  length:value.size()
+                                encoding:NSISOLatin1StringEncoding];
+}
+
+NSDictionary<NSString*, NSString*>* BuildNormalizedResponseHeaders(
+    const net::HttpResponseHeaders* headers) {
+  if (!headers) {
+    return @{};
+  }
+  std::map<std::string, std::string> coalesced;
+  size_t iter = 0;
+  std::string name;
+  std::string value;
+  while (headers->EnumerateHeaderLines(&iter, &name, &value)) {
+    const std::string lower_name = base::ToLowerASCII(name);
+    auto [it, inserted] = coalesced.try_emplace(lower_name, value);
+    if (!inserted) {
+      it->second.append(", ");
+      it->second.append(value);
+    }
+  }
+  NSMutableDictionary<NSString*, NSString*>* result =
+      [NSMutableDictionary dictionaryWithCapacity:coalesced.size()];
+  for (const auto& [lower_name, combined_value] : coalesced) {
+    NSString* ns_name = base::SysUTF8ToNSString(lower_name);
+    NSString* ns_value = HeaderValueToNSString(combined_value);
+    if (ns_name && ns_value) {
+      result[ns_name] = ns_value;
+    }
+  }
+  return [result copy];
+}
