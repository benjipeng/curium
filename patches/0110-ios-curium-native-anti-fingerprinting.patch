+namespace {
+
+uint64_t ReadLE64(base::span<const uint8_t> bytes, size_t offset) {
+  uint64_t v = 0;
+  for (size_t i = 0; i < 8; ++i) {
+    v |= static_cast<uint64_t>(bytes[offset + i]) << (i * 8);
+  }
+  return v;
+}
+
+uint64_t SplitMix64(uint64_t x) {
+  x += 0x9E3779B97F4A7C15ULL;
+  x = (x ^ (x >> 30)) * 0xBF58476D1CE4E5B9ULL;
+  x = (x ^ (x >> 27)) * 0x94D049BB133111EBULL;
+  return x ^ (x >> 31);
+}
+
+std::array<uint8_t, 32> HmacSha256(base::span<const uint8_t, 32> key,
+                                   std::string_view message) {
+  std::vector<uint8_t> inner;
+  inner.reserve(64 + message.size());
+  for (size_t i = 0; i < 64; ++i) {
+    inner.push_back(static_cast<uint8_t>((i < 32 ? key[i] : 0u) ^ 0x36u));
+  }
+  for (char c : message) {
+    inner.push_back(static_cast<uint8_t>(c));
+  }
+  const std::array<uint8_t, 32> inner_hash = crypto::hash::Sha256(inner);
+
+  std::array<uint8_t, 96> outer{};
+  for (size_t i = 0; i < 64; ++i) {
+    outer[i] = static_cast<uint8_t>((i < 32 ? key[i] : 0u) ^ 0x5cu);
+  }
+  std::copy(inner_hash.begin(), inner_hash.end(), outer.begin() + 64);
+  return crypto::hash::Sha256(outer);
+}
+
+bool StartsWithCaseInsensitive(std::string_view value,
+                               std::string_view prefix) {
+  return value.size() >= prefix.size() &&
+         base::EqualsCaseInsensitiveASCII(value.substr(0, prefix.size()),
+                                          prefix);
+}
