+
+FontProfile EffectiveFontProfile(const LaunchConfig& cfg) {
+  if (cfg.font_profile.has_value()) {
+    return *cfg.font_profile;
+  }
+  if (cfg.schema_version < 2) {
+    return FontProfile::kNative;
+  }
+  const IdentitySlotConfig& def = cfg.DefaultIdentity();
+  if (def.platform.has_value()) {
+    if (*def.platform == "Windows") {
+      return FontProfile::kWindows;
+    }
+    if (*def.platform == "Linux" || *def.platform == "Chrome OS" ||
+        *def.platform == "Chromium OS") {
+      return FontProfile::kLinux;
+    }
+    if (*def.platform == "Android") {
+      return FontProfile::kAndroid;
+    }
+    if (*def.platform == "macOS" || *def.platform == "iOS") {
+      return FontProfile::kApple;
+    }
+  }
+  return FontProfile::kNative;
+}
+
+WebGLProfile EffectiveWebGLProfile(const LaunchConfig& cfg,
+                                   const IdentitySlotConfig& slot,
+                                   const blink::UserAgentMetadata& metadata) {
+  if (slot.webgl_profile.has_value()) {
+    return *slot.webgl_profile;
+  }
+  if (cfg.schema_version < 2) {
+    return WebGLProfile::kNative;
+  }
+  if (metadata.platform == "Windows") {
+    return WebGLProfile::kDesktopWindows;
+  }
+  if (metadata.platform == "Linux" || metadata.platform == "Chrome OS" ||
+      metadata.platform == "Chromium OS") {
+    return WebGLProfile::kDesktopLinux;
+  }
+  if (metadata.platform == "Android") {
+    return WebGLProfile::kMobileAndroid;
+  }
+  return WebGLProfile::kNative;
+}
