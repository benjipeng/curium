+  if (SkImageInfo::ByteSizeOverflowed(size)) {
+    return false;
+  }
+  sk_sp<SkData> owned_data = SkData::MakeZeroInitialized(size);
+  if (!owned_data) {
+    return false;
+  }
+  SkPixmap owned_pixmap(info, owned_data->writable_data(), row_bytes);
+  if (!pixmap_.readPixels(owned_pixmap, 0, 0)) {
