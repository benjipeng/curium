+std::optional<std::array<uint8_t, 32>> DeriveSiteKey(
+    std::string_view site_scope) {
+  const LaunchConfig* cfg = GetLaunchConfig();
+  if (!cfg || !cfg->fingerprint_seed.has_value() || site_scope.empty()) {
+    return std::nullopt;
+  }
+  return HmacSha256(*cfg->fingerprint_seed, site_scope);
+}
+
+void FarbleRGBA8Pixels(base::span<const uint8_t, 32> site_key,
+                       uint8_t* pixels,
+                       int width,
+                       int height,
+                       size_t row_bytes,
+                       int origin_x,
+                       int origin_y,
+                       bool is_bgra) {
+  if (!pixels || width <= 0 || height <= 0 ||
+      row_bytes < static_cast<size_t>(width) * 4u) {
+    return;
+  }
+  const uint64_t k0 = ReadLE64(site_key, 0);
+  const uint64_t k1 = ReadLE64(site_key, 8);
+  const size_t r_idx = is_bgra ? 2u : 0u;
+  const size_t g_idx = 1u;
+  const size_t b_idx = is_bgra ? 0u : 2u;
+  const size_t a_idx = 3u;
+  const std::array<size_t, 3> rgb_indices = {r_idx, g_idx, b_idx};
+
+  for (int y = 0; y < height; ++y) {
+    uint8_t* row = pixels + static_cast<size_t>(y) * row_bytes;
+    const uint64_t wy =
+        static_cast<uint64_t>(static_cast<int64_t>(origin_y) + y) *
+        0xBF58476D1CE4E5B9ULL;
+    for (int x = 0; x < width; ++x) {
+      uint8_t* px = row + static_cast<size_t>(x) * 4u;
+      // Only perturb opaque pixels; leave alpha and premul-sensitive edges untouched.
+      if (px[a_idx] != 255u) {
+        continue;
+      }
+      const uint64_t wx =
+          static_cast<uint64_t>(static_cast<int64_t>(origin_x) + x) *
+          0x9E3779B97F4A7C15ULL;
+      const uint64_t h = SplitMix64(k0 ^ wx ^ wy ^ k1);
+      // Perturb ~25% of opaque pixels by +-1 LSB on one RGB channel.
+      if ((h & 0x3ULL) != 0ULL) {
+        continue;
+      }
+      const size_t ch = rgb_indices[(h >> 2) % 3u];
+      const int delta = ((h >> 4) & 1ULL) ? 1 : -1;
+      const uint8_t cur = px[ch];
+      if (cur == 0u) {
+        px[ch] = 1u;
+      } else if (cur == 255u) {
+        px[ch] = 254u;
+      } else {
+        px[ch] = static_cast<uint8_t>(static_cast<int>(cur) + delta);
+      }
+    }
+  }
+}
+
+double ResolveTextMetricsScale(base::span<const uint8_t, 32> site_key,
+                               std::string_view font_family) {
+  if (!IsTextMetricsFarblingEnabled()) {
+    return 1.0;
+  }
+  uint64_t acc = ReadLE64(site_key, 16);
+  for (unsigned char c : font_family) {
+    acc = SplitMix64(acc ^ static_cast<uint64_t>(base::ToLowerASCII(c)));
+  }
+  const uint64_t h = SplitMix64(acc ^ ReadLE64(site_key, 24));
+  // Deterministic scale in [1 - 1e-4, 1 + 1e-4], excluding exact 0.
+  const double unit =
+      (static_cast<double>(h & 0xFFFFULL) / 65535.0) * 2.0 - 1.0;
+  double eps = unit * 1e-4;
+  if (std::fabs(eps) < 1e-6) {
+    eps = (h & 0x10000ULL) ? 1e-5 : -1e-5;
+  }
+  return 1.0 + eps;
+}
+
+void FarbleAudioSamples(base::span<const uint8_t, 32> site_key,
+                        uint32_t stream_tag,
+                        float* samples,
+                        size_t count) {
+  if (!samples || count == 0) {
+    return;
+  }
+  const uint64_t k0 = ReadLE64(site_key, 8) ^
+                      (static_cast<uint64_t>(stream_tag) * 0x9E3779B97F4A7C15ULL);
+  const uint64_t k1 = ReadLE64(site_key, 24);
+  for (size_t i = 0; i < count; ++i) {
+    const float v = samples[i];
+    if (!std::isfinite(v) || v == 0.0f) {
+      continue;
+    }
+    const uint64_t h = SplitMix64(k0 ^ (static_cast<uint64_t>(i) * 0xD1B54A32D192ED03ULL) ^ k1);
+    const float unit =
+        (static_cast<float>(h & 0xFFFFULL) / 65535.0f) * 2.0f - 1.0f;
+    samples[i] = v * (1.0f + unit * 1e-6f);
+  }
+}
+
+bool IsWebGLExtensionAllowed(const blink::UserAgentMetadata& metadata,
+                             std::string_view extension_name) {
+  const LaunchConfig* cfg = GetLaunchConfig();
+  if (!cfg) {
+    return true;
+  }
+  const IdentitySlotConfig& slot = cfg->SelectSlotForMetadata(metadata);
+  const WebGLProfile profile = EffectiveWebGLProfile(*cfg, slot, metadata);
+  if (profile == WebGLProfile::kNative ||
+      profile == WebGLProfile::kDesktopMacOS) {
+    return true;
+  }
+  // Subtractive filtering only: never advertise extensions ANGLE-on-Metal
+  // cannot actually instantiate.
+  if (base::EqualsCaseInsensitiveASCII(extension_name,
+                                       "WEBGL_compressed_texture_pvrtc")) {
+    return false;
+  }
+  if (profile == WebGLProfile::kDesktopWindows ||
+      profile == WebGLProfile::kDesktopLinux) {
+    if (base::EqualsCaseInsensitiveASCII(extension_name,
+                                         "WEBGL_compressed_texture_etc") ||
+        base::EqualsCaseInsensitiveASCII(extension_name,
+                                         "WEBGL_compressed_texture_etc1") ||
+        base::EqualsCaseInsensitiveASCII(extension_name,
+                                         "WEBGL_compressed_texture_astc")) {
+      return false;
+    }
+  }
+  return true;
+}
+
+int32_t ClampWebGLLimit(const blink::UserAgentMetadata& metadata,
+                        uint32_t pname,
+                        int32_t real_value) {
+  const LaunchConfig* cfg = GetLaunchConfig();
+  if (!cfg || real_value <= 0) {
+    return real_value;
+  }
+  const IdentitySlotConfig& slot = cfg->SelectSlotForMetadata(metadata);
+  constexpr uint32_t kGlMaxTextureSize = 0x0D33;
+  constexpr uint32_t kGlMaxCubeMapTextureSize = 0x851C;
+  constexpr uint32_t kGlMaxRenderbufferSize = 0x84E8;
+  constexpr uint32_t kGlMaxVertexAttribs = 0x8869;
+
+  int32_t cap = real_value;
+  if (pname == kGlMaxTextureSize && slot.webgl_max_texture_size.has_value()) {
+    cap = std::min(cap, *slot.webgl_max_texture_size);
+  } else if (pname == kGlMaxRenderbufferSize &&
+             slot.webgl_max_renderbuffer_size.has_value()) {
+    cap = std::min(cap, *slot.webgl_max_renderbuffer_size);
+  } else if (pname == kGlMaxCubeMapTextureSize &&
+             slot.webgl_max_cube_map_texture_size.has_value()) {
+    cap = std::min(cap, *slot.webgl_max_cube_map_texture_size);
+  } else if (pname == kGlMaxVertexAttribs) {
+    const WebGLProfile profile = EffectiveWebGLProfile(*cfg, slot, metadata);
+    if (profile == WebGLProfile::kDesktopWindows ||
+        profile == WebGLProfile::kDesktopLinux ||
+        profile == WebGLProfile::kMobileAndroid) {
+      cap = std::min(cap, 16);
+    }
+  }
+  return std::min(real_value, cap);
+}
+
+bool IsFontFamilyAllowedForLaunch(std::string_view family_or_face,
+                                  bool is_unique_face) {
+  const LaunchConfig* cfg = GetLaunchConfig();
+  if (!cfg) {
+    return true;
+  }
+  const FontProfile profile = EffectiveFontProfile(*cfg);
+  if (profile == FontProfile::kNative || profile == FontProfile::kApple) {
+    return true;
+  }
+  if (family_or_face.empty()) {
+    return true;
+  }
+  // Never block generic CSS families or standard Blink internal names.
+  if (base::EqualsCaseInsensitiveASCII(family_or_face, "serif") ||
+      base::EqualsCaseInsensitiveASCII(family_or_face, "sans-serif") ||
+      base::EqualsCaseInsensitiveASCII(family_or_face, "monospace") ||
+      base::EqualsCaseInsensitiveASCII(family_or_face, "cursive") ||
+      base::EqualsCaseInsensitiveASCII(family_or_face, "fantasy") ||
+      base::EqualsCaseInsensitiveASCII(family_or_face, "system-ui") ||
+      base::EqualsCaseInsensitiveASCII(family_or_face, "math") ||
+      base::EqualsCaseInsensitiveASCII(family_or_face, "emoji") ||
+      base::EqualsCaseInsensitiveASCII(family_or_face, "fangsong") ||
+      StartsWithCaseInsensitive(family_or_face, "-webkit-")) {
+    return true;
+  }
+  // Block Apple-only UI family names and Apple-exclusive bundled system fonts
+  // when emulating Windows, Linux, or Android.
+  if (base::EqualsCaseInsensitiveASCII(family_or_face, "-apple-system") ||
+      base::EqualsCaseInsensitiveASCII(family_or_face, "blinkmacsystemfont") ||
+      base::EqualsCaseInsensitiveASCII(family_or_face, "ui-serif") ||
+      base::EqualsCaseInsensitiveASCII(family_or_face, "ui-sans-serif") ||
+      base::EqualsCaseInsensitiveASCII(family_or_face, "ui-monospace") ||
+      base::EqualsCaseInsensitiveASCII(family_or_face, "ui-rounded")) {
+    return false;
+  }
+  (void)is_unique_face;
+  return !IsBlockedAppleExclusiveFont(family_or_face);
+}
+
+bool AllowAppleSystemFontAliases() {
+  const LaunchConfig* cfg = GetLaunchConfig();
+  if (!cfg) {
+    return true;
+  }
+  const FontProfile profile = EffectiveFontProfile(*cfg);
+  return profile == FontProfile::kNative || profile == FontProfile::kApple;
+}
+
+std::optional<ResolvedScreenMetrics> ResolveWebScreenMetrics(
+    const blink::UserAgentMetadata& metadata,
+    int viewport_width,
+    int viewport_height) {
+  const LaunchConfig* cfg = GetLaunchConfig();
+  if (!cfg) {
+    return std::nullopt;
+  }
+  const IdentitySlotConfig& slot = cfg->SelectSlotForMetadata(metadata);
+  if (!slot.screen.has_value()) {
+    return std::nullopt;
+  }
+
+  ResolvedScreenMetrics m;
+  m.width = slot.screen->width;
+  m.height = slot.screen->height;
+  m.avail_width = slot.screen->avail_width;
+  m.avail_height = slot.screen->avail_height;
+  m.color_depth = slot.screen->color_depth;
+  m.is_desktop = !metadata.mobile;
+
+  // Enforce geometric coherence on foldable iPhone Duo (e.g. 951x669 unfolded):
+  // screen.availWidth >= viewport_width && screen.availHeight >= viewport_height
+  // for the physical root window DIP size, preserving configured taskbar/dock
+  // deltas (avail_dx, avail_dy) on stretch.
+  if (viewport_width > m.avail_width || viewport_height > m.avail_height) {
+    const int avail_dx = std::max(0, m.width - m.avail_width);
+    const int avail_dy = std::max(0, m.height - m.avail_height);
+    if (m.is_desktop) {
+      m.width = std::max(m.width, 1440);
+      m.height = std::max(m.height, 900);
+    } else if (viewport_width >= viewport_height) {
+      // Unfolded Duo in landscape mobile slot: step up to tablet class.
+      m.width = std::max(m.width, 1024);
+      m.height = std::max(m.height, 768);
+    }
+    m.width = std::max(m.width, viewport_width + avail_dx);
+    m.height = std::max(m.height, viewport_height + avail_dy);
+    m.avail_width = m.width - avail_dx;
+    m.avail_height = m.height - avail_dy;
+  }
+  m.is_landscape = (m.width >= m.height);
+  m.orientation_angle = 0;
+  return m;
+}
+
+bool ShouldExposePdfViewer(const blink::UserAgentMetadata& metadata) {
+  const LaunchConfig* cfg = GetLaunchConfig();
+  if (!cfg) {
+    return false;
+  }
+  const IdentitySlotConfig& slot = cfg->SelectSlotForMetadata(metadata);
+  if (slot.pdf_viewer_enabled.has_value()) {
+    return *slot.pdf_viewer_enabled;
+  }
+  return cfg->schema_version >= 2 && !metadata.mobile;
+}
+
+bool ShouldHideSpeechVoices(const blink::UserAgentMetadata& metadata) {
+  const LaunchConfig* cfg = GetLaunchConfig();
+  if (!cfg) {
+    return false;
+  }
+  const bool enabled =
+      cfg->hide_speech_voices.value_or(cfg->schema_version >= 2);
+  if (!enabled) {
+    return false;
+  }
+  return metadata.platform != "macOS" && metadata.platform != "iOS";
+}
+
 }  // namespace blink::curium
