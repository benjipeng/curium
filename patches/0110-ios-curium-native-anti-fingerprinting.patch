+      SkImages::RasterFromData(info, std::move(owned_data), row_bytes);
+  if (!owned_image) {
+    return false;
+  }
+  SkPixmap bound_pixmap;
+  if (!owned_image->peekPixels(&bound_pixmap)) {
+    return false;
+  }
+  retained_image_ = std::move(owned_image);
+  pixmap_ = bound_pixmap;
