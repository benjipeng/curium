+void HTMLMediaElement::pauseForBindings() {
+#if BUILDFLAG(IS_IOS)
+  if (!ended() &&
+      PictureInPictureController::IsElementInPictureInPicture(this)) {
+    Document& doc = GetDocument();
+    PictureInPictureController& pip = PictureInPictureController::From(doc);
+    const base::TimeTicks now = base::TimeTicks::Now();
+    const base::TimeTicks ms_pause = pip.LastMediaSessionPauseTime();
+    const bool from_media_session =
+        !ms_pause.is_null() && (now - ms_pause) < base::Milliseconds(750);
+    if (!from_media_session) {
+      const base::TimeTicks enter_time = pip.LastPictureInPictureEnterTime();
+      const bool within_enter_guard =
+          !enter_time.is_null() &&
+          (now - enter_time) < base::Milliseconds(500);
+      const bool page_hidden_or_unfocused =
+          doc.hidden() ||
+          (doc.GetPage() && !doc.GetPage()->GetFocusController().IsFocused());
+      const bool has_user_activation =
+          LocalFrame::HasTransientUserActivation(doc.GetFrame());
+      if (within_enter_guard ||
+          (page_hidden_or_unfocused && !has_user_activation)) {
+        return;
+      }
+    }
+  }
+#endif
+  pause();
