diff --git a/ios/web/content/picture_in_picture/ios_video_overlay_window.mm b/ios/web/content/picture_in_picture/ios_video_overlay_window.mm
index db70043..5d64de7 100644
--- a/ios/web/content/picture_in_picture/ios_video_overlay_window.mm
+++ b/ios/web/content/picture_in_picture/ios_video_overlay_window.mm
@@ -45,6 +45,551 @@
 constexpr CFTimeInterval kStartRetryDelaySeconds = 0.25;
 constexpr NSUInteger kMaxStartRetries = 1;
 
+constexpr CFTimeInterval kSeekGuardWindowSeconds = 3.5;
+constexpr double kSeekLandingToleranceSeconds = 2.5;
+constexpr double kMinDropSeparationSeconds = 1.5;
+constexpr double kRenderPreSeekSlackSeconds = 1.5;
+constexpr double kRenderPreSeekMaxAdvanceSeconds = 2.5;
+constexpr double kDiscontinuityBackwardToleranceSeconds = 0.05;
+constexpr double kDiscontinuityForwardToleranceSeconds = 1.5;
+constexpr double kTimebaseOffsetThresholdSeconds = 2.0;
+constexpr NSUInteger kNotReadyFlushThreshold = 8;
+
+char kRenderQueueSpecificKey = 0;
+
+void FlushVideoRenderer(AVSampleBufferVideoRenderer* renderer) {
+  if (!renderer) {
+    return;
+  }
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+  [renderer flush];
+#pragma clang diagnostic pop
+}
+
+inline bool IsSeekableDuration(double duration_seconds) {
+  return std::isfinite(duration_seconds) && duration_seconds > 0.0;
+}
+
+inline double SanitizedRate(bool paused, double rate) {
+  if (paused) {
+    return 0.0;
+  }
+  if (!std::isfinite(rate) || rate <= 0.0) {
+    return 1.0;
+  }
+  return rate;
+}
+
+inline double ClampPosition(double value, double duration_seconds) {
+  if (!std::isfinite(value) || value < 0.0) {
+    value = 0.0;
+  }
+  if (IsSeekableDuration(duration_seconds) && value > duration_seconds) {
+    value = duration_seconds;
+  }
+  return value;
+}
+
+double EstimateMediaPosition(double base_pos,
+                             double duration_seconds,
+                             bool paused,
+                             double playback_rate,
+                             CFTimeInterval base_wall_time,
+                             CFTimeInterval now) {
+  double pos = std::isfinite(base_pos) ? base_pos : 0.0;
+  const double rate = SanitizedRate(paused, playback_rate);
+  if (!paused && rate > 0.0 && base_wall_time > 0.0 && std::isfinite(now) &&
+      now > base_wall_time) {
+    pos += (now - base_wall_time) * rate;
+  }
+  return ClampPosition(pos, duration_seconds);
+}
+
+double ComputeSkipTarget(double current_pos,
+                         double duration_seconds,
+                         double delta_seconds) {
+  if (!IsSeekableDuration(duration_seconds)) {
+    return ClampPosition(current_pos, duration_seconds);
+  }
+  const double base = ClampPosition(current_pos, duration_seconds);
+  const double delta = std::isfinite(delta_seconds) ? delta_seconds : 0.0;
+  return ClampPosition(base + delta, duration_seconds);
+}
+
+double InferTimebaseOffset(double timebase_seconds, double current_pos) {
+  if (!std::isfinite(timebase_seconds) || !std::isfinite(current_pos)) {
+    return 0.0;
+  }
+  const double tb_non_neg = std::max(0.0, timebase_seconds);
+  if (tb_non_neg > current_pos + kTimebaseOffsetThresholdSeconds) {
+    return std::max(0.0, tb_non_neg - current_pos);
+  }
+  return 0.0;
+}
+
+CMTimeRange ComputePlayableTimeRange(double duration_seconds,
+                                     double estimated_pos,
+                                     double timebase_seconds) {
+  if (!IsSeekableDuration(duration_seconds)) {
+    return CMTimeRangeMake(kCMTimeZero, kCMTimePositiveInfinity);
+  }
+  const double clamped_pos = ClampPosition(estimated_pos, duration_seconds);
+  double start_sec = 0.0;
+  double span = duration_seconds;
+  if (std::isfinite(timebase_seconds)) {
+    const double tb_non_neg = std::max(0.0, timebase_seconds);
+    // Handle small, medium, and high-PTS HLS/DVR epochs cleanly while keeping
+    // start == 0 when controlTimebase is unprimed at 0 s mid-stream.
+    if (tb_non_neg > clamped_pos + kTimebaseOffsetThresholdSeconds) {
+      start_sec = std::max(0.0, tb_non_neg - clamped_pos);
+    }
+    // Guarantee [start_sec, start_sec + span] always contains tb_non_neg so
+    // AVKit never concludes playback ended from a slightly ahead timebase.
+    if (tb_non_neg < start_sec) {
+      start_sec = tb_non_neg;
+    }
+    if (tb_non_neg > start_sec + span) {
+      span = tb_non_neg - start_sec;
+    }
+  }
+  return CMTimeRangeMake(CMTimeMakeWithSeconds(start_sec, 1000000),
+                         CMTimeMakeWithSeconds(std::max(span, 0.001), 1000000));
+}
+
+void EnsurePlaybackAudioSession(bool muted) {
+  AVAudioSession* session = [AVAudioSession sharedInstance];
+  AVAudioSessionCategory cat = session.category;
+  if ([cat isEqualToString:AVAudioSessionCategoryPlayAndRecord]) {
+    return;
+  }
+  const AVAudioSessionCategoryOptions desired_options =
+      muted ? AVAudioSessionCategoryOptionMixWithOthers : 0;
+  if (![cat isEqualToString:AVAudioSessionCategoryPlayback] ||
+      session.categoryOptions != desired_options) {
+    NSError* err = nil;
+    [session setCategory:AVAudioSessionCategoryPlayback
+                    mode:AVAudioSessionModeDefault
+                 options:desired_options
+                   error:&err];
+  }
+  NSError* active_err = nil;
+  [session setActive:YES error:&active_err];
+}
+
+enum class RenderFrameAction {
+  kRenderNormal = 0,
+  kDropStalePreSeek = 1,
+  kFlushAndRenderPostSeek = 2,
+  kFlushDiscontinuity = 3,
+};
+
+// Synchronizes AVKit playback/skip/coalescing state between main & render queues.
+class PiPSkipState {
+ public:
+  void NoteGeneration(uint64_t generation) {
+    base::AutoLock lock(lock_);
+    EnsureGenerationLocked(generation);
+  }
+
+  void RecordPlaybackUpdate(uint64_t generation,
+                            bool paused,
+                            double rate,
+                            bool has_position,
+                            double position_seconds,
+                            double duration_seconds,
+                            CFTimeInterval now) {
+    base::AutoLock lock(lock_);
+    EnsureGenerationLocked(generation);
+    ExpireGuardsLocked(generation, now);
+
+    const double eff_rate = SanitizedRate(paused, rate);
+    const bool was_paused = last_known_paused_;
+    const double prev_rate = last_known_rate_;
+    const bool valid_pos = has_position && std::isfinite(position_seconds);
+    const double clamped_pos =
+        valid_pos ? ClampPosition(position_seconds, duration_seconds) : 0.0;
+
+    if (render_seek_guard_active_) {
+      expected_target_pts_ = CurrentExpectedTargetPtsLocked(now);
+      expected_target_anchor_wall_time_ = now;
+      expected_target_paused_ = paused;
+      expected_target_rate_ = eff_rate;
+    }
+
+    if (pending_seek_active_) {
+      const double expected_pos = CurrentPendingTargetLocked(
+          duration_seconds, was_paused, prev_rate, now);
+      if (valid_pos &&
+          std::fabs(clamped_pos - expected_pos) <= kSeekLandingToleranceSeconds) {
+        last_known_position_seconds_ = clamped_pos;
+        position_wall_time_ = now;
+        has_position_wall_time_ = true;
+        pending_seek_active_ = false;
+      } else {
+        pending_target_seconds_ = expected_pos;
+        pending_seek_set_at_ = now;
+        pending_seek_active_ = true;
+      }
+    } else {
+      if (!valid_pos && has_position_wall_time_) {
+        if (!was_paused && paused) {
+          last_known_position_seconds_ = EstimateMediaPosition(
+              last_known_position_seconds_, duration_seconds, false, prev_rate,
+              position_wall_time_, now);
+          position_wall_time_ = now;
+        } else if (was_paused && !paused) {
+          position_wall_time_ = now;
+        }
+      } else if (valid_pos) {
+        last_known_position_seconds_ = clamped_pos;
+        position_wall_time_ = now;
+        has_position_wall_time_ = true;
+      }
+    }
+
+    last_known_paused_ = paused;
+    last_known_rate_ = eff_rate;
+  }
+
+  double EstimatedPosition(uint64_t generation,
+                           double fallback_pos,
+                           double duration_seconds,
+                           bool paused,
+                           double playback_rate,
+                           CFTimeInterval now) {
+    base::AutoLock lock(lock_);
+    EnsureGenerationLocked(generation);
+    ExpireGuardsLocked(generation, now);
+
+    if (pending_seek_active_ && std::isfinite(now) &&
+        now < media_seek_guard_until_) {
+      return CurrentPendingTargetLocked(duration_seconds, paused, playback_rate,
+                                        now);
+    }
+    pending_seek_active_ = false;
+    const double base_pos =
+        has_position_wall_time_ ? last_known_position_seconds_ : fallback_pos;
+    const CFTimeInterval wall_time =
+        has_position_wall_time_ ? position_wall_time_ : 0.0;
+    return EstimateMediaPosition(base_pos, duration_seconds, paused,
+                                 playback_rate, wall_time, now);
+  }
+
+  double BeginSkip(uint64_t generation,
+                   double delta_seconds,
+                   double fallback_pos,
+                   double duration_seconds,
+                   bool paused,
+                   double playback_rate,
+                   double timebase_seconds,
+                   CFTimeInterval now,
+                   double* out_target_timebase_seconds) {
+    base::AutoLock lock(lock_);
+    EnsureGenerationLocked(generation);
+    ExpireGuardsLocked(generation, now);
+
+    const double eff_rate = SanitizedRate(paused, playback_rate);
+    double cur_pos = 0.0;
+    if (pending_seek_active_ && std::isfinite(now) &&
+        now < media_seek_guard_until_) {
+      cur_pos = CurrentPendingTargetLocked(duration_seconds, paused, eff_rate,
+                                           now);
+    } else {
+      const double base_pos =
+          has_position_wall_time_ ? last_known_position_seconds_ : fallback_pos;
+      const CFTimeInterval wall_time =
+          has_position_wall_time_ ? position_wall_time_ : 0.0;
+      cur_pos = EstimateMediaPosition(base_pos, duration_seconds, paused,
+                                      eff_rate, wall_time, now);
+    }
+
+    const double target_sec =
+        ComputeSkipTarget(cur_pos, duration_seconds, delta_seconds);
+    const double tb_offset = InferTimebaseOffset(timebase_seconds, cur_pos);
+    const double target_tb = target_sec + tb_offset;
+
+    pending_seek_active_ = true;
+    pending_target_seconds_ = target_sec;
+    pending_seek_set_at_ = now;
+    media_seek_guard_until_ = now + kSeekGuardWindowSeconds;
+
+    if (!render_seek_guard_active_) {
+      if (has_last_rendered_pts_) {
+        pre_seek_pts_ = last_rendered_pts_;
+        has_pre_seek_pts_ = true;
+      } else if (std::isfinite(timebase_seconds)) {
+        pre_seek_pts_ = timebase_seconds;
+        has_pre_seek_pts_ = true;
+      } else {
+        pre_seek_pts_ = 0.0;
+        has_pre_seek_pts_ = false;
+      }
+      render_seek_guard_started_at_ = now;
+    }
+
+    render_seek_guard_active_ = true;
+    render_seek_guard_generation_ = generation;
+    render_seek_guard_until_ = now + kSeekGuardWindowSeconds;
+    expected_target_pts_ = target_tb;
+    expected_target_anchor_wall_time_ = now;
+    expected_target_rate_ = eff_rate;
+    expected_target_paused_ = paused;
+    consecutive_not_ready_count_ = 0;
+
+    if (out_target_timebase_seconds) {
+      *out_target_timebase_seconds = target_tb;
+    }
+    return target_sec;
+  }
+
+  RenderFrameAction EvaluateRenderFramePTS(double frame_pts_seconds,
+                                           uint64_t generation,
+                                           CFTimeInterval now) {
+    if (!std::isfinite(frame_pts_seconds)) {
+      return RenderFrameAction::kRenderNormal;
+    }
+    base::AutoLock lock(lock_);
+    EnsureGenerationLocked(generation);
+    ExpireGuardsLocked(generation, now);
+
+    if (render_seek_guard_active_) {
+      const double expected_now = CurrentExpectedTargetPtsLocked(now);
+      double pre_now = pre_seek_pts_;
+      if (has_pre_seek_pts_ && !expected_target_paused_ &&
+          expected_target_rate_ > 0.0 && std::isfinite(now) &&
+          now > render_seek_guard_started_at_) {
+        const double adv =
+            (now - render_seek_guard_started_at_) * expected_target_rate_;
+        pre_now += std::min(adv, kRenderPreSeekMaxAdvanceSeconds);
+      }
+
+      const double seek_sep =
+          has_pre_seek_pts_ ? std::fabs(expected_now - pre_seek_pts_) : 0.0;
+      const double dist_to_target =
+          std::fabs(frame_pts_seconds - expected_now);
+      const double dist_to_pre =
+          has_pre_seek_pts_
+              ? std::min(std::fabs(frame_pts_seconds - pre_seek_pts_),
+                         std::fabs(frame_pts_seconds - pre_now))
+              : INFINITY;
+      const bool in_pre_seek_window =
+          has_pre_seek_pts_ && frame_pts_seconds >= (pre_seek_pts_ - 0.5) &&
+          frame_pts_seconds <= (pre_now + kRenderPreSeekSlackSeconds);
+      if (seek_sep >= kMinDropSeparationSeconds && in_pre_seek_window &&
+          dist_to_target > 1.2 && dist_to_pre < dist_to_target) {
+        return RenderFrameAction::kDropStalePreSeek;
+      }
+
+      render_seek_guard_active_ = false;
+      has_pre_seek_pts_ = false;
+      last_rendered_pts_ = frame_pts_seconds;
+      has_last_rendered_pts_ = true;
+      consecutive_not_ready_count_ = 0;
+      return RenderFrameAction::kFlushAndRenderPostSeek;
+    }
+
+    bool discontinuity = false;
+    if (has_last_rendered_pts_) {
+      if (frame_pts_seconds <
+              last_rendered_pts_ - kDiscontinuityBackwardToleranceSeconds ||
+          frame_pts_seconds >
+              last_rendered_pts_ + kDiscontinuityForwardToleranceSeconds) {
+        discontinuity = true;
+      }
+    }
+
+    last_rendered_pts_ = frame_pts_seconds;
+    has_last_rendered_pts_ = true;
+    if (discontinuity) {
+      consecutive_not_ready_count_ = 0;
+      return RenderFrameAction::kFlushDiscontinuity;
+    }
+    return RenderFrameAction::kRenderNormal;
+  }
+
+  NSUInteger RecordNotReadyFrame(uint64_t generation) {
+    base::AutoLock lock(lock_);
+    EnsureGenerationLocked(generation);
+    return ++consecutive_not_ready_count_;
+  }
+
+  void ResetNotReadyCount(uint64_t generation) {
+    base::AutoLock lock(lock_);
+    EnsureGenerationLocked(generation);
+    consecutive_not_ready_count_ = 0;
+  }
+
+  uint64_t RecordSetPlaying(bool playing,
+                            bool current_paused,
+                            uint64_t generation,
+                            bool* out_should_schedule_flush) {
+    base::AutoLock lock(lock_);
+    EnsureGenerationLocked(generation);
+
+    bool should_schedule = false;
+    if (!has_pending_set_playing_) {
+      pre_set_playing_paused_ = current_paused;
+      pending_set_playing_value_ = playing;
+      ++pending_set_playing_token_;
+      if (playing != (!pre_set_playing_paused_)) {
+        has_pending_set_playing_ = true;
+        should_schedule = true;
+      }
+    } else {
+      pending_set_playing_value_ = playing;
+      ++pending_set_playing_token_;
+      if (playing == (!pre_set_playing_paused_)) {
+        has_pending_set_playing_ = false;
+        should_schedule = false;
+      } else {
+        has_pending_set_playing_ = true;
+        should_schedule = true;
+      }
+    }
+    if (out_should_schedule_flush) {
+      *out_should_schedule_flush = should_schedule;
+    }
+    return pending_set_playing_token_;
+  }
+
+  bool ConsumePendingSetPlaying(uint64_t token,
+                                uint64_t generation,
+                                bool* out_playing) {
+    base::AutoLock lock(lock_);
+    if (!has_observed_generation_ || generation_ != generation ||
+        !has_pending_set_playing_ || pending_set_playing_token_ != token) {
+      return false;
+    }
+    has_pending_set_playing_ = false;
+    const bool target_playing = pending_set_playing_value_;
+    if (target_playing == (!pre_set_playing_paused_)) {
+      return false;
+    }
+    if (out_playing) {
+      *out_playing = target_playing;
+    }
+    return true;
+  }
+
+  bool EffectivePausedForSkip(bool current_paused, uint64_t generation) {
+    base::AutoLock lock(lock_);
+    EnsureGenerationLocked(generation);
+    return (has_pending_set_playing_ && !pending_set_playing_value_)
+               ? pre_set_playing_paused_
+               : current_paused;
+  }
+
+ private:
+  void EnsureGenerationLocked(uint64_t generation) EXCLUSIVE_LOCKS_REQUIRED(lock_) {
+    if (!has_observed_generation_ || generation_ != generation) {
+      const bool is_subsequent =
+          has_observed_generation_ && generation_ != 0 && generation != generation_;
+      generation_ = generation;
+      has_observed_generation_ = true;
+      pending_seek_active_ = false;
+      pending_target_seconds_ = 0.0;
+      pending_seek_set_at_ = 0.0;
+      media_seek_guard_until_ = 0.0;
+      render_seek_guard_active_ = false;
+      render_seek_guard_generation_ = generation;
+      render_seek_guard_started_at_ = 0.0;
+      render_seek_guard_until_ = 0.0;
+      has_pre_seek_pts_ = false;
+      pre_seek_pts_ = 0.0;
+      expected_target_pts_ = 0.0;
+      expected_target_anchor_wall_time_ = 0.0;
+      expected_target_rate_ = 1.0;
+      expected_target_paused_ = false;
+      has_last_rendered_pts_ = false;
+      last_rendered_pts_ = 0.0;
+      consecutive_not_ready_count_ = 0;
+      has_pending_set_playing_ = false;
+      pending_set_playing_value_ = false;
+      pre_set_playing_paused_ = false;
+      ++pending_set_playing_token_;
+      if (is_subsequent) {
+        has_position_wall_time_ = false;
+        position_wall_time_ = 0.0;
+        last_known_position_seconds_ = 0.0;
+      }
+    }
+  }
+
+  double CurrentPendingTargetLocked(double duration_seconds,
+                                    bool paused,
+                                    double rate,
+                                    CFTimeInterval now) const
+      EXCLUSIVE_LOCKS_REQUIRED(lock_) {
+    const double eff_rate = SanitizedRate(paused, rate);
+    double pos = pending_target_seconds_;
+    if (!paused && eff_rate > 0.0 && std::isfinite(now) &&
+        now > pending_seek_set_at_) {
+      pos += (now - pending_seek_set_at_) * eff_rate;
+    }
+    return ClampPosition(pos, duration_seconds);
+  }
+
+  double CurrentExpectedTargetPtsLocked(CFTimeInterval now) const
+      EXCLUSIVE_LOCKS_REQUIRED(lock_) {
+    double pts = expected_target_pts_;
+    if (!expected_target_paused_ && expected_target_rate_ > 0.0 &&
+        std::isfinite(now) && now > expected_target_anchor_wall_time_) {
+      pts += (now - expected_target_anchor_wall_time_) * expected_target_rate_;
+    }
+    return pts;
+  }
+
