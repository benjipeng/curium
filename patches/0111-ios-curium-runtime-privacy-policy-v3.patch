+void SeedRuntimePolicyFromLaunchConfig(const LaunchConfig* cfg) {
+  RuntimePolicySnapshot seeded;
+  seeded.policy_revision = 0;
+  bool auto_hide_default = false;
+
+  if (cfg) {
+    if (cfg->fingerprint_seed.has_value()) {
+      seeded.fingerprint_seed_bytes = cfg->fingerprint_seed;
+      seeded.fingerprint_seed_hex = BytesToLowerHex(*cfg->fingerprint_seed);
+      seeded.farbling.canvas = cfg->farble_canvas;
+      seeded.farbling.audio = cfg->farble_audio;
+      seeded.farbling.webgl = cfg->farble_webgl;
+      seeded.farbling.text_metrics = cfg->farble_text_metrics;
+    }
+    seeded.webrtc_ip_handling_policy = cfg->webrtc_ip_handling_policy;
+    seeded.enable_do_not_track = cfg->enable_do_not_track;
+    seeded.enable_global_privacy_control = cfg->enable_global_privacy_control;
+    const IdentitySlotConfig& primary = cfg->DefaultIdentity();
+    auto_hide_default = cfg->schema_version >= 2 &&
+                        primary.platform.has_value() &&
+                        !primary.platform->empty() &&
+                        *primary.platform != "macOS" &&
+                        *primary.platform != "iOS";
+    if (cfg->hide_speech_voices.has_value()) {
+      seeded.hide_speech_voices = *cfg->hide_speech_voices;
+      seeded.hide_speech_voices_explicit = true;
+    } else {
+      seeded.hide_speech_voices = auto_hide_default;
+      seeded.hide_speech_voices_explicit = false;
+    }
+  }
+
+  RuntimePolicyStorage& storage = GetPolicyStorage();
+  base::AutoLock auto_lock(storage.lock);
+  storage.auto_hide_speech_voices_default = auto_hide_default;
+  storage.snapshot = std::move(seeded);
+  storage.fast_flags.store(ComputeFastFlags(storage.snapshot),
+                           std::memory_order_release);
+  storage.revision.store(0, std::memory_order_release);
+}
+
+bool ApplyRuntimePolicyJSON(std::string_view json,
+                            RuntimePolicyError* error_out) {
+  ParsedRuntimePolicyPatch patch;
+  if (!ParseRuntimePolicyPatch(json, &patch, error_out)) {
+    return false;
+  }
+
+  RuntimePolicyStorage& storage = GetPolicyStorage();
+  RuntimePolicySnapshot committed;
+  std::vector<BrowserObserverEntry> browser_observers;
+  std::vector<RendererObserverEntry> renderer_observers;
+
+  {
+    base::AutoLock auto_lock(storage.lock);
+    RuntimePolicySnapshot next = storage.snapshot;
+    const bool had_seed = next.fingerprint_seed_bytes.has_value();
+
+    if (patch.has_fingerprint_seed) {
+      next.fingerprint_seed_bytes = patch.fingerprint_seed_bytes;
+      next.fingerprint_seed_hex = patch.fingerprint_seed_hex;
+      if (!next.fingerprint_seed_bytes.has_value()) {
+        next.farbling = FarblingConfig{};
+      }
+    }
+
+    if (patch.has_farbling) {
+      if (patch.clear_farbling) {
+        next.farbling = FarblingConfig{};
+      } else {
+        if (patch.farble_canvas.has_value()) {
+          next.farbling.canvas = *patch.farble_canvas;
+        }
+        if (patch.farble_audio.has_value()) {
+          next.farbling.audio = *patch.farble_audio;
+        }
+        if (patch.farble_webgl.has_value()) {
+          next.farbling.webgl = *patch.farble_webgl;
+        }
+        if (patch.farble_text_metrics.has_value()) {
+          next.farbling.text_metrics = *patch.farble_text_metrics;
+        }
+      }
+    } else if (!had_seed && next.fingerprint_seed_bytes.has_value() &&
+               !next.farbling.AnyEnabled()) {
+      next.farbling.canvas = true;
+      next.farbling.audio = true;
+      next.farbling.webgl = true;
+      next.farbling.text_metrics = true;
+    }
+
+    if (patch.webrtc_ip_handling_policy.has_value()) {
+      next.webrtc_ip_handling_policy = *patch.webrtc_ip_handling_policy;
+    }
+    if (patch.enable_do_not_track.has_value()) {
+      next.enable_do_not_track = *patch.enable_do_not_track;
+    }
+    if (patch.enable_global_privacy_control.has_value()) {
+      next.enable_global_privacy_control = *patch.enable_global_privacy_control;
+    }
+    if (patch.has_hide_speech_voices) {
+      if (patch.clear_hide_speech_voices) {
+        next.hide_speech_voices_explicit = false;
+        next.hide_speech_voices = storage.auto_hide_speech_voices_default;
+      } else if (patch.hide_speech_voices.has_value()) {
+        next.hide_speech_voices_explicit = true;
+        next.hide_speech_voices = *patch.hide_speech_voices;
+      }
+    }
+
+    const uint64_t prev_monotonic =
+        storage.revision.load(std::memory_order_relaxed);
+    const uint64_t next_monotonic =
+        patch.policy_revision.has_value()
+            ? std::max<uint64_t>(prev_monotonic + 1u, *patch.policy_revision)
+            : (prev_monotonic + 1u);
+    next.policy_revision = patch.policy_revision.value_or(next_monotonic);
+
+    storage.snapshot = next;
+    storage.fast_flags.store(ComputeFastFlags(storage.snapshot),
+                             std::memory_order_release);
+    storage.revision.store(next_monotonic, std::memory_order_release);
+
+    committed = next;
+    browser_observers = storage.browser_observers;
+    renderer_observers = storage.renderer_observers;
+  }
+
+  for (const BrowserObserverEntry& entry : browser_observers) {
+    if (!entry.callback.is_null()) {
+      entry.callback.Run(committed);
+    }
+  }
+  for (const RendererObserverEntry& entry : renderer_observers) {
+    if (entry.task_runner && !entry.callback.is_null()) {
+      entry.task_runner->PostTask(FROM_HERE,
+                                  base::BindOnce(entry.callback, committed));
+    }
+  }
+
+  return true;
+}
+
+RuntimePolicySnapshot GetRuntimePolicySnapshot() {
+  RuntimePolicyStorage& storage = GetPolicyStorage();
+  base::AutoLock auto_lock(storage.lock);
+  return storage.snapshot;
+}
+
+uint64_t GetCurrentRuntimePolicyRevision() {
+  return GetPolicyStorage().revision.load(std::memory_order_acquire);
+}
+
+bool IsRuntimeFarblingEnabled() {
+  return (GetPolicyStorage().fast_flags.load(std::memory_order_acquire) &
+          kFlagFarblingActive) != 0u;
+}
+
+bool IsRuntimeCanvasFarblingEnabled() {
+  return (GetPolicyStorage().fast_flags.load(std::memory_order_acquire) &
+          kFlagCanvasFarbling) != 0u;
+}
+
+bool IsRuntimeAudioFarblingEnabled() {
+  return (GetPolicyStorage().fast_flags.load(std::memory_order_acquire) &
+          kFlagAudioFarbling) != 0u;
+}
+
+bool IsRuntimeWebGLFarblingEnabled() {
+  return (GetPolicyStorage().fast_flags.load(std::memory_order_acquire) &
+          kFlagWebGLFarbling) != 0u;
+}
+
+bool IsRuntimeTextMetricsFarblingEnabled() {
+  return (GetPolicyStorage().fast_flags.load(std::memory_order_acquire) &
+          kFlagTextMetricsFarbling) != 0u;
+}
+
+bool IsGlobalPrivacyControlRuntimeEnabled() {
+  return (GetPolicyStorage().fast_flags.load(std::memory_order_acquire) &
+          kFlagGlobalPrivacyControl) != 0u;
+}
+
+bool ShouldHideSpeechVoicesRuntime() {
+  return (GetPolicyStorage().fast_flags.load(std::memory_order_acquire) &
+          kFlagHideSpeechVoices) != 0u;
+}
+
+bool HasExplicitHideSpeechVoicesRuntimePolicy() {
+  return (GetPolicyStorage().fast_flags.load(std::memory_order_acquire) &
+          kFlagHideSpeechVoicesExplicit) != 0u;
+}
+
+std::optional<std::array<uint8_t, 32>> GetActiveFingerprintSeedBytes() {
+  if (!IsRuntimeFarblingEnabled()) {
+    return std::nullopt;
+  }
+  RuntimePolicyStorage& storage = GetPolicyStorage();
+  base::AutoLock auto_lock(storage.lock);
+  if (!storage.snapshot.fingerprint_seed_bytes.has_value() ||
+      !storage.snapshot.farbling.AnyEnabled()) {
+    return std::nullopt;
+  }
+  return storage.snapshot.fingerprint_seed_bytes;
+}
+
+std::string_view WebRtcIpHandlingPolicyToString(
+    blink::mojom::WebRtcIpHandlingPolicy policy) {
+  switch (policy) {
+    case blink::mojom::WebRtcIpHandlingPolicy::kDefault:
+      return "default";
+    case blink::mojom::WebRtcIpHandlingPolicy::
+        kDefaultPublicAndPrivateInterfaces:
+      return "default_public_and_private_interfaces";
+    case blink::mojom::WebRtcIpHandlingPolicy::kDefaultPublicInterfaceOnly:
+      return "default_public_interface_only";
+    case blink::mojom::WebRtcIpHandlingPolicy::kDisableNonProxiedUdp:
+      return "disable_non_proxied_udp";
+  }
+  return "default";
+}
+
+void RegisterBrowserPolicyObserver(void* token,
+                                   RuntimePolicyObserverCallback callback) {
+  if (!token || callback.is_null()) {
+    return;
+  }
+  const uintptr_t token_id = reinterpret_cast<uintptr_t>(token);
+  RuntimePolicyStorage& storage = GetPolicyStorage();
+  base::AutoLock auto_lock(storage.lock);
+  for (BrowserObserverEntry& entry : storage.browser_observers) {
+    if (entry.token == token_id) {
+      entry.callback = std::move(callback);
+      return;
+    }
+  }
+  storage.browser_observers.push_back(
+      BrowserObserverEntry{token_id, std::move(callback)});
+}
+
+void UnregisterBrowserPolicyObserver(void* token) {
+  if (!token) {
+    return;
+  }
+  const uintptr_t token_id = reinterpret_cast<uintptr_t>(token);
+  RuntimePolicyStorage& storage = GetPolicyStorage();
+  base::AutoLock auto_lock(storage.lock);
+  auto& observers = storage.browser_observers;
+  observers.erase(
+      std::remove_if(observers.begin(), observers.end(),
+                     [token_id](const BrowserObserverEntry& entry) {
+                       return entry.token == token_id;
+                     }),
+      observers.end());
+}
+
+void RegisterRendererPolicyObserver(
+    scoped_refptr<base::SequencedTaskRunner> task_runner,
+    RuntimePolicyObserverCallback callback) {
+  if (!task_runner || callback.is_null()) {
+    return;
+  }
+  RuntimePolicySnapshot current;
+  {
+    RuntimePolicyStorage& storage = GetPolicyStorage();
+    base::AutoLock auto_lock(storage.lock);
+    storage.renderer_observers.push_back(
+        RendererObserverEntry{task_runner, callback});
+    current = storage.snapshot;
+  }
+
+  if (task_runner->RunsTasksInCurrentSequence()) {
+    callback.Run(current);
+  } else {
+    task_runner->PostTask(FROM_HERE,
+                          base::BindOnce(std::move(callback),
+                                         std::move(current)));
+  }
+}
+
+void RegisterProfileCachePurgeHook(
+    scoped_refptr<base::SequencedTaskRunner> task_runner,
+    base::RepeatingClosure callback) {
+  if (!task_runner || callback.is_null()) {
+    return;
+  }
+  RuntimePolicyStorage& storage = GetPolicyStorage();
+  base::AutoLock auto_lock(storage.lock);
+  storage.cache_purge_hooks.push_back(
+      CachePurgeHookEntry{std::move(task_runner), std::move(callback)});
+}
+
+void PurgeProfileRuntimeCaches() {
+  std::vector<CachePurgeHookEntry> hooks;
+  {
+    RuntimePolicyStorage& storage = GetPolicyStorage();
+    base::AutoLock auto_lock(storage.lock);
+    hooks = storage.cache_purge_hooks;
+  }
+  for (const CachePurgeHookEntry& entry : hooks) {
+    if (entry.task_runner && !entry.callback.is_null()) {
+      entry.task_runner->PostTask(FROM_HERE, entry.callback);
+    }
+  }
+}
+
+}  // namespace blink::curium
