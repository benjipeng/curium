+constexpr uint32_t kFlagFarblingActive = 1u << 0;
+constexpr uint32_t kFlagCanvasFarbling = 1u << 1;
+constexpr uint32_t kFlagAudioFarbling = 1u << 2;
+constexpr uint32_t kFlagWebGLFarbling = 1u << 3;
+constexpr uint32_t kFlagTextMetricsFarbling = 1u << 4;
+constexpr uint32_t kFlagGlobalPrivacyControl = 1u << 5;
+constexpr uint32_t kFlagHideSpeechVoices = 1u << 6;
+constexpr uint32_t kFlagHideSpeechVoicesExplicit = 1u << 7;
+
+constexpr double kMaxSafeJsonUint64 = 9007199254740991.0;
+
+bool Fail(RuntimePolicyError* error_out, ErrorCode code, std::string message) {
+  if (error_out) {
+    error_out->code = code;
+    error_out->message = std::move(message);
+  }
+  return false;
+}
+
+std::string BytesToLowerHex(const std::array<uint8_t, 32>& bytes) {
+  static constexpr char kHex[] = "0123456789abcdef";
+  std::string out;
+  out.reserve(64);
+  for (uint8_t b : bytes) {
+    out.push_back(kHex[b >> 4]);
+    out.push_back(kHex[b & 0x0Fu]);
+  }
+  return out;
+}
+
+uint32_t ComputeFastFlags(const RuntimePolicySnapshot& snapshot) {
+  uint32_t flags = 0u;
+  if (snapshot.fingerprint_seed_bytes.has_value()) {
+    if (snapshot.farbling.AnyEnabled()) {
+      flags |= kFlagFarblingActive;
+    }
+    if (snapshot.farbling.canvas) {
+      flags |= kFlagCanvasFarbling;
+    }
+    if (snapshot.farbling.audio) {
+      flags |= kFlagAudioFarbling;
+    }
+    if (snapshot.farbling.webgl) {
+      flags |= kFlagWebGLFarbling;
+    }
+    if (snapshot.farbling.text_metrics) {
+      flags |= kFlagTextMetricsFarbling;
+    }
+  }
+  if (snapshot.enable_global_privacy_control) {
+    flags |= kFlagGlobalPrivacyControl;
+  }
+  if (snapshot.hide_speech_voices) {
+    flags |= kFlagHideSpeechVoices;
+  }
+  if (snapshot.hide_speech_voices_explicit) {
+    flags |= kFlagHideSpeechVoicesExplicit;
+  }
+  return flags;
+}
