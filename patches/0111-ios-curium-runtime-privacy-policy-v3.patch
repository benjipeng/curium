+v8::Local<v8::String> MakeCuriumGPCV8String(v8::Isolate* isolate,
+                                            std::string_view value) {
+  return v8::String::NewFromUtf8(isolate, value.data(),
+                                 v8::NewStringType::kNormal,
+                                 static_cast<int>(value.size()))
+      .ToLocalChecked();
+}
+
+v8::Local<v8::String> MakeCuriumGPCV8Key(v8::Isolate* isolate,
+                                         std::string_view key) {
+  return v8::String::NewFromUtf8(isolate, key.data(),
+                                 v8::NewStringType::kInternalized,
+                                 static_cast<int>(key.size()))
+      .ToLocalChecked();
+}
+
+void CuriumNavigatorGPCCallback(
+    const v8::FunctionCallbackInfo<v8::Value>& info) {
+  v8::Isolate* isolate = info.GetIsolate();
+  v8::Local<v8::Context> context = isolate->GetCurrentContext();
+  v8::Local<v8::Data> data = info.Data();
+  if (context.IsEmpty() || data.IsEmpty() || !data->IsValue()) {
+    isolate->ThrowException(v8::Exception::TypeError(
+        MakeCuriumGPCV8String(isolate, "Illegal invocation")));
+    return;
+  }
+  v8::Local<v8::Value> data_val = data.As<v8::Value>();
+  if (!data_val->IsFunction()) {
+    isolate->ThrowException(v8::Exception::TypeError(
+        MakeCuriumGPCV8String(isolate, "Illegal invocation")));
+    return;
+  }
+  v8::Local<v8::Function> brand_check = data_val.As<v8::Function>();
+  v8::TryCatch try_catch(isolate);
+  v8::Local<v8::Value> ignored;
+  if (!brand_check->Call(isolate, context, info.This(), 0, nullptr)
+           .ToLocal(&ignored)) {
+    if (try_catch.HasCaught()) {
+      try_catch.ReThrow();
+    } else {
+      isolate->ThrowException(v8::Exception::TypeError(
+          MakeCuriumGPCV8String(isolate, "Illegal invocation")));
+    }
+    return;
+  }
+  info.GetReturnValue().Set(
+      blink::curium::IsGlobalPrivacyControlRuntimeEnabled());
+}
+
+void MaybeInstallCuriumNavigatorGPC(v8::Local<v8::Context> context) {
+  if (!blink::curium::IsGlobalPrivacyControlRuntimeEnabled() ||
+      context.IsEmpty()) {
+    return;
+  }
+  v8::Isolate* isolate = v8::Isolate::GetCurrent();
+  if (!isolate) {
+    return;
+  }
+
+  v8::HandleScope handle_scope(isolate);
+  v8::MicrotasksScope microtasks_scope(
+      isolate, context->GetMicrotaskQueue(),
+      v8::MicrotasksScope::kDoNotRunMicrotasks);
+  v8::Context::Scope context_scope(context);
+  v8::TryCatch try_catch(isolate);
+
+  v8::Local<v8::Value> navigator_val;
+  if (!context->Global()
+           ->Get(context, MakeCuriumGPCV8Key(isolate, "navigator"))
+           .ToLocal(&navigator_val) ||
+      navigator_val.IsEmpty() || !navigator_val->IsObject()) {
+    return;
+  }
+  v8::Local<v8::Object> navigator_obj = navigator_val.As<v8::Object>();
+  v8::Local<v8::Value> proto_val = navigator_obj->GetPrototype();
+  if (proto_val.IsEmpty() || !proto_val->IsObject()) {
+    return;
+  }
+  v8::Local<v8::Object> navigator_proto = proto_val.As<v8::Object>();
+  v8::Local<v8::String> gpc_key =
+      MakeCuriumGPCV8Key(isolate, "globalPrivacyControl");
+  if (navigator_proto->HasOwnProperty(context, gpc_key).FromMaybe(false)) {
+    return;
+  }
+
+  v8::Local<v8::Value> online_desc_val;
+  if (!navigator_proto
+           ->GetOwnPropertyDescriptor(context,
+                                      MakeCuriumGPCV8Key(isolate, "onLine"))
+           .ToLocal(&online_desc_val) ||
+      online_desc_val.IsEmpty() || !online_desc_val->IsObject()) {
+    return;
+  }
+  v8::Local<v8::Value> brand_getter_val;
+  if (!online_desc_val.As<v8::Object>()
+           ->Get(context, MakeCuriumGPCV8Key(isolate, "get"))
+           .ToLocal(&brand_getter_val) ||
+      brand_getter_val.IsEmpty() || !brand_getter_val->IsFunction()) {
+    return;
+  }
+
+  v8::Local<v8::FunctionTemplate> tmpl = v8::FunctionTemplate::New(
+      isolate, &CuriumNavigatorGPCCallback, brand_getter_val,
+      v8::Local<v8::Signature>(), /*length=*/0,
+      v8::ConstructorBehavior::kThrow);
+  tmpl->RemovePrototype();
+  tmpl->SetClassName(MakeCuriumGPCV8String(isolate, "get globalPrivacyControl"));
+
+  v8::Local<v8::Function> getter_fn;
+  if (!tmpl->GetFunction(context).ToLocal(&getter_fn)) {
+    return;
+  }
+  getter_fn->SetName(MakeCuriumGPCV8String(isolate, "get globalPrivacyControl"));
+  navigator_proto->SetAccessorProperty(gpc_key, getter_fn,
+                                       v8::Local<v8::Function>(),
+                                       v8::PropertyAttribute::None);
+}
