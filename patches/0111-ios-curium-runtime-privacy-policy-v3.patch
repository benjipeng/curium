+
+struct ParsedRuntimePolicyPatch {
+  std::optional<uint64_t> policy_revision;
+  bool has_fingerprint_seed = false;
+  std::optional<std::array<uint8_t, 32>> fingerprint_seed_bytes;
+  std::optional<std::string> fingerprint_seed_hex;
+  bool has_farbling = false;
+  bool clear_farbling = false;
+  std::optional<bool> farble_canvas;
+  std::optional<bool> farble_audio;
+  std::optional<bool> farble_webgl;
+  std::optional<bool> farble_text_metrics;
+  std::optional<blink::mojom::WebRtcIpHandlingPolicy> webrtc_ip_handling_policy;
+  std::optional<bool> enable_do_not_track;
+  std::optional<bool> enable_global_privacy_control;
+  bool has_hide_speech_voices = false;
+  bool clear_hide_speech_voices = false;
+  std::optional<bool> hide_speech_voices;
+};
+
+bool ParseRuntimePolicyPatch(std::string_view json,
+                             ParsedRuntimePolicyPatch* out_patch,
+                             RuntimePolicyError* error_out) {
+  if (json.empty()) {
+    return Fail(error_out, ErrorCode::kInvalidJSON,
+                "Runtime privacy policy JSON must not be empty");
+  }
+  if (json.size() > kMaxRuntimePolicyBytes) {
+    return Fail(error_out, ErrorCode::kPayloadTooLarge,
+                "Runtime privacy policy exceeds 16 KiB limit");
+  }
+  auto parsed = base::JSONReader::ReadAndReturnValueWithError(
+      json, base::JSON_PARSE_RFC);
+  if (!parsed.has_value()) {
+    return Fail(error_out, ErrorCode::kInvalidJSON,
+                "JSON parse error: " + parsed.error().message);
+  }
+  const base::DictValue* root = parsed->GetIfDict();
+  if (!root) {
+    return Fail(error_out, ErrorCode::kInvalidJSON,
+                "Root runtime privacy policy must be a JSON object");
+  }
+
+  static constexpr std::array<std::string_view, 8> kAllowedKeys = {
+      "policySchemaVersion",
+      "policyRevision",
+      "fingerprintSeed",
+      "farbling",
+      "webrtcIpHandlingPolicy",
+      "enableDoNotTrack",
+      "enableGlobalPrivacyControl",
+      "hideSpeechVoices",
+  };
+  for (const auto [key, value] : *root) {
+    if (std::find(kAllowedKeys.begin(), kAllowedKeys.end(), key) ==
+        kAllowedKeys.end()) {
+      return Fail(error_out, ErrorCode::kInvalidField,
+                  "Unknown runtime privacy policy key: " + key);
+    }
+  }
+
+  const base::Value* schema_val = root->Find("policySchemaVersion");
+  if (!schema_val || !schema_val->is_int()) {
+    return Fail(error_out, ErrorCode::kInvalidField,
+                "policySchemaVersion integer is required");
+  }
+  const int schema_version = schema_val->GetInt();
+  if (schema_version != kRuntimePolicySchemaVersion) {
+    return Fail(error_out, ErrorCode::kUnsupportedSchema,
+                "Unsupported policySchemaVersion: " +
+                    base::NumberToString(schema_version));
+  }
+
+  ParsedRuntimePolicyPatch patch;
+
+  if (const base::Value* rev = root->Find("policyRevision")) {
+    if (rev->is_int()) {
+      const int v = rev->GetInt();
+      if (v < 0) {
+        return Fail(error_out, ErrorCode::kInvalidField,
+                    "policyRevision must be non-negative");
+      }
+      patch.policy_revision = static_cast<uint64_t>(v);
+    } else if (rev->is_double()) {
+      const double d = rev->GetDouble();
+      if (!std::isfinite(d) || d < 0.0 || d > kMaxSafeJsonUint64 ||
+          std::floor(d) != d) {
+        return Fail(
+            error_out, ErrorCode::kInvalidField,
+            "policyRevision must be an integer in [0, 9007199254740991]");
+      }
+      patch.policy_revision = static_cast<uint64_t>(d);
+    } else {
+      return Fail(error_out, ErrorCode::kInvalidField,
+                  "policyRevision must be an integer");
+    }
+  }
+
+  if (const base::Value* seed_val = root->Find("fingerprintSeed")) {
+    patch.has_fingerprint_seed = true;
+    if (seed_val->is_none()) {
+      patch.fingerprint_seed_bytes = std::nullopt;
+      patch.fingerprint_seed_hex = std::nullopt;
+    } else if (const std::string* hex = seed_val->GetIfString()) {
+      std::vector<uint8_t> bytes;
+      if (hex->size() != 64 || !base::HexStringToBytes(*hex, &bytes) ||
+          bytes.size() != 32) {
+        return Fail(error_out, ErrorCode::kInvalidField,
+                    "fingerprintSeed must be null or a 64-character hex string");
+      }
+      std::array<uint8_t, 32> seed{};
+      std::copy(bytes.begin(), bytes.end(), seed.begin());
+      patch.fingerprint_seed_bytes = seed;
+      patch.fingerprint_seed_hex = base::ToLowerASCII(*hex);
+    } else {
+      return Fail(error_out, ErrorCode::kInvalidField,
+                  "fingerprintSeed must be null or a 64-character hex string");
+    }
+  }
+
+  if (const base::Value* farb_val = root->Find("farbling")) {
+    patch.has_farbling = true;
+    if (farb_val->is_none()) {
+      patch.clear_farbling = true;
+    } else if (const base::DictValue* fdict = farb_val->GetIfDict()) {
+      for (const auto [k, v] : *fdict) {
+        if (k != "canvas" && k != "audio" && k != "webgl" &&
+            k != "textMetrics") {
+          return Fail(error_out, ErrorCode::kInvalidField,
+                      "Unknown key in farbling: " + k);
+        }
+        if (!v.is_bool()) {
+          return Fail(error_out, ErrorCode::kInvalidField,
+                      "farbling." + k + " must be bool");
+        }
+      }
+      patch.farble_canvas = fdict->FindBool("canvas");
+      patch.farble_audio = fdict->FindBool("audio");
+      patch.farble_webgl = fdict->FindBool("webgl");
+      patch.farble_text_metrics = fdict->FindBool("textMetrics");
+    } else {
+      return Fail(error_out, ErrorCode::kInvalidField,
+                  "farbling must be null or an object");
+    }
+  }
+
+  if (const base::Value* webrtc = root->Find("webrtcIpHandlingPolicy")) {
+    const std::string* s = webrtc->GetIfString();
+    if (!s) {
+      return Fail(error_out, ErrorCode::kInvalidField,
+                  "webrtcIpHandlingPolicy must be a string");
+    }
+    if (*s == "default") {
+      patch.webrtc_ip_handling_policy =
+          blink::mojom::WebRtcIpHandlingPolicy::kDefault;
+    } else if (*s == "default_public_and_private_interfaces") {
+      patch.webrtc_ip_handling_policy = blink::mojom::WebRtcIpHandlingPolicy::
+          kDefaultPublicAndPrivateInterfaces;
+    } else if (*s == "default_public_interface_only") {
+      patch.webrtc_ip_handling_policy =
+          blink::mojom::WebRtcIpHandlingPolicy::kDefaultPublicInterfaceOnly;
+    } else if (*s == "disable_non_proxied_udp") {
+      patch.webrtc_ip_handling_policy =
+          blink::mojom::WebRtcIpHandlingPolicy::kDisableNonProxiedUdp;
+    } else {
+      return Fail(error_out, ErrorCode::kInvalidField,
+                  "Invalid webrtcIpHandlingPolicy: " + *s);
+    }
+  }
+
+  if (const base::Value* dnt = root->Find("enableDoNotTrack")) {
+    if (!dnt->is_bool()) {
+      return Fail(error_out, ErrorCode::kInvalidField,
+                  "enableDoNotTrack must be bool");
+    }
+    patch.enable_do_not_track = dnt->GetBool();
+  }
+
+  if (const base::Value* gpc = root->Find("enableGlobalPrivacyControl")) {
+    if (!gpc->is_bool()) {
+      return Fail(error_out, ErrorCode::kInvalidField,
+                  "enableGlobalPrivacyControl must be bool");
+    }
+    patch.enable_global_privacy_control = gpc->GetBool();
+  }
+
+  if (const base::Value* hsv = root->Find("hideSpeechVoices")) {
+    patch.has_hide_speech_voices = true;
+    if (hsv->is_none()) {
+      patch.clear_hide_speech_voices = true;
+    } else if (hsv->is_bool()) {
+      patch.hide_speech_voices = hsv->GetBool();
+    } else {
+      return Fail(error_out, ErrorCode::kInvalidField,
+                  "hideSpeechVoices must be null or bool");
+    }
+  }
+
+  *out_patch = std::move(patch);
+  return true;
+}
