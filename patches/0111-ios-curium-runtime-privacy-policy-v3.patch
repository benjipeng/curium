+
+namespace blink::curium {
+
+inline constexpr int kRuntimePolicySchemaVersion = 1;
+inline constexpr size_t kMaxRuntimePolicyBytes = 16384;
+
+struct BLINK_COMMON_EXPORT FarblingConfig {
+  bool canvas = false;
+  bool audio = false;
+  bool webgl = false;
+  bool text_metrics = false;
+
+  bool AnyEnabled() const {
+    return canvas || audio || webgl || text_metrics;
+  }
+};
+
+struct BLINK_COMMON_EXPORT RuntimePolicyError {
+  RuntimePolicyError();
+  RuntimePolicyError(ErrorCode code, std::string message);
+  RuntimePolicyError(const RuntimePolicyError&);
+  RuntimePolicyError(RuntimePolicyError&&) noexcept;
+  RuntimePolicyError& operator=(const RuntimePolicyError&);
+  RuntimePolicyError& operator=(RuntimePolicyError&&) noexcept;
+  ~RuntimePolicyError();
+
+  ErrorCode code = ErrorCode::kNone;
+  std::string message;
+};
+
+struct BLINK_COMMON_EXPORT RuntimePolicySnapshot {
+  RuntimePolicySnapshot();
+  RuntimePolicySnapshot(const RuntimePolicySnapshot&);
+  RuntimePolicySnapshot(RuntimePolicySnapshot&&) noexcept;
+  RuntimePolicySnapshot& operator=(const RuntimePolicySnapshot&);
+  RuntimePolicySnapshot& operator=(RuntimePolicySnapshot&&) noexcept;
+  ~RuntimePolicySnapshot();
+
+  uint64_t policy_revision = 0;
+  std::optional<std::array<uint8_t, 32>> fingerprint_seed_bytes;
+  std::optional<std::string> fingerprint_seed_hex;
+  FarblingConfig farbling;
+  blink::mojom::WebRtcIpHandlingPolicy webrtc_ip_handling_policy =
+      blink::mojom::WebRtcIpHandlingPolicy::kDefault;
+  bool enable_do_not_track = false;
+  bool enable_global_privacy_control = false;
+  bool hide_speech_voices = false;
+  bool hide_speech_voices_explicit = false;
+};
+
+using RuntimePolicyObserverCallback =
+    base::RepeatingCallback<void(const RuntimePolicySnapshot&)>;
+
+// Seeds the live runtime privacy policy snapshot from the frozen launch config
+// at policy revision 0. Passing nullptr resets to default Build 39 values.
+BLINK_COMMON_EXPORT void SeedRuntimePolicyFromLaunchConfig(
+    const LaunchConfig* cfg);
+
+// Validates and atomically applies a bounded UTF-8 runtime privacy policy JSON
+// payload (<= 16 KiB, policySchemaVersion == 1, strict key allowlist). Fails
+// closed without mutating active policy state on any error.
+BLINK_COMMON_EXPORT bool ApplyRuntimePolicyJSON(
+    std::string_view json,
+    RuntimePolicyError* error_out);
+
+// Returns a thread-safe copy of the active runtime privacy policy snapshot.
+BLINK_COMMON_EXPORT RuntimePolicySnapshot GetRuntimePolicySnapshot();
+
+// Lock-free monotonic runtime policy revision counter (0 until the first
+// successful ApplyRuntimePolicyJSON call).
+BLINK_COMMON_EXPORT uint64_t GetCurrentRuntimePolicyRevision();
+
+// Lock-free hot-path flag readers backed by atomic state.
+BLINK_COMMON_EXPORT bool IsRuntimeFarblingEnabled();
+BLINK_COMMON_EXPORT bool IsRuntimeCanvasFarblingEnabled();
+BLINK_COMMON_EXPORT bool IsRuntimeAudioFarblingEnabled();
+BLINK_COMMON_EXPORT bool IsRuntimeWebGLFarblingEnabled();
+BLINK_COMMON_EXPORT bool IsRuntimeTextMetricsFarblingEnabled();
+BLINK_COMMON_EXPORT bool IsGlobalPrivacyControlRuntimeEnabled();
+BLINK_COMMON_EXPORT bool ShouldHideSpeechVoicesRuntime();
+BLINK_COMMON_EXPORT bool HasExplicitHideSpeechVoicesRuntimePolicy();
+
+// Thread-safe copy of the active 32-byte farbling seed when farbling is active.
+BLINK_COMMON_EXPORT std::optional<std::array<uint8_t, 32>>
+GetActiveFingerprintSeedBytes();
+
+// Canonical wire-string name for WebRtcIpHandlingPolicy.
+BLINK_COMMON_EXPORT std::string_view WebRtcIpHandlingPolicyToString(
+    blink::mojom::WebRtcIpHandlingPolicy policy);
+
+// Registers/unregisters browser-side observers invoked synchronously on the
+// caller (UI) thread after ApplyRuntimePolicyJSON commits a new snapshot.
+BLINK_COMMON_EXPORT void RegisterBrowserPolicyObserver(
+    void* token,
+    RuntimePolicyObserverCallback callback);
+BLINK_COMMON_EXPORT void UnregisterBrowserPolicyObserver(void* token);
+
+// Registers a renderer-side observer invoked immediately with the current
+// snapshot (synchronously when already on `task_runner`) and posted onto
+// `task_runner` whenever ApplyRuntimePolicyJSON commits a new snapshot.
+BLINK_COMMON_EXPORT void RegisterRendererPolicyObserver(
+    scoped_refptr<base::SequencedTaskRunner> task_runner,
+    RuntimePolicyObserverCallback callback);
+
+// Future-ready (Build 44) hook allowing renderer runtime caches to be purged
+// asynchronously on their owning sequence.
+BLINK_COMMON_EXPORT void RegisterProfileCachePurgeHook(
+    scoped_refptr<base::SequencedTaskRunner> task_runner,
+    base::RepeatingClosure callback);
+BLINK_COMMON_EXPORT void PurgeProfileRuntimeCaches();
+
+}  // namespace blink::curium
