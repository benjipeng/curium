+  info.GetReturnValue().Set(v8::Boolean::New(info.GetIsolate(), false));
+}
+
+void CuriumAppRunningStateCallback(
+    const v8::FunctionCallbackInfo<v8::Value>& info) {
+  info.GetReturnValue().Set(MakeV8String(info.GetIsolate(), "cannot_run"));
+}
+
+void InstallCuriumDesktopChromeObject(v8::Local<v8::Context> context) {
+  v8::Isolate* isolate = v8::Isolate::GetCurrent();
+  if (!isolate || context.IsEmpty()) {
+    return;
+  }
+
+  v8::HandleScope handle_scope(isolate);
+  v8::MicrotasksScope microtasks_scope(
+      isolate, context->GetMicrotaskQueue(),
+      v8::MicrotasksScope::kDoNotRunMicrotasks);
+  v8::Context::Scope context_scope(context);
+
+  v8::Local<v8::Object> chrome =
+      content::GetOrCreateChromeObject(isolate, context);
+
+  if (!HasDefinedProperty(isolate, context, chrome, "loadTimes")) {
+    v8::Local<v8::Function> load_times_fn;
+    if (MakeNativeFunction(isolate, context, &CuriumLoadTimesCallback,
+                           "loadTimes")
+            .ToLocal(&load_times_fn)) {
+      std::ignore =
+          SetProperty(isolate, context, chrome, "loadTimes", load_times_fn);
+    }
+  }
+
+  if (!HasDefinedProperty(isolate, context, chrome, "csi")) {
+    v8::Local<v8::Function> csi_fn;
+    if (MakeNativeFunction(isolate, context, &CuriumCSICallback, "csi")
+            .ToLocal(&csi_fn)) {
+      std::ignore = SetProperty(isolate, context, chrome, "csi", csi_fn);
+    }
+  }
+
+  if (!HasDefinedProperty(isolate, context, chrome, "app")) {
+    v8::Local<v8::Object> app = v8::Object::New(isolate);
+    std::ignore = SetProperty(isolate, context, app, "isInstalled",
+                              v8::Boolean::New(isolate, false));
+
+    v8::Local<v8::Object> install_state = v8::Object::New(isolate);
+    std::ignore = SetProperty(isolate, context, install_state, "DISABLED",
+                              MakeV8String(isolate, "disabled"));
+    std::ignore = SetProperty(isolate, context, install_state, "INSTALLED",
+                              MakeV8String(isolate, "installed"));
+    std::ignore = SetProperty(isolate, context, install_state, "NOT_INSTALLED",
+                              MakeV8String(isolate, "not_installed"));
+    std::ignore =
+        SetProperty(isolate, context, app, "InstallState", install_state);
+
+    v8::Local<v8::Object> running_state = v8::Object::New(isolate);
+    std::ignore = SetProperty(isolate, context, running_state, "CANNOT_RUN",
+                              MakeV8String(isolate, "cannot_run"));
+    std::ignore = SetProperty(isolate, context, running_state, "READY_TO_RUN",
+                              MakeV8String(isolate, "ready_to_run"));
+    std::ignore = SetProperty(isolate, context, running_state, "RUNNING",
+                              MakeV8String(isolate, "running"));
+    std::ignore =
+        SetProperty(isolate, context, app, "RunningState", running_state);
+
