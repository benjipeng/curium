+class CuriumDesktopChromeObserver final : public content::RenderFrameObserver {
+ public:
+  explicit CuriumDesktopChromeObserver(content::RenderFrame* render_frame)
+      : content::RenderFrameObserver(render_frame) {}
+
+  void DidCreateScriptContext(v8::Local<v8::Context> context,
+                              int32_t world_id) override {
+    if (world_id != content::ISOLATED_WORLD_ID_GLOBAL || context.IsEmpty()) {
+      return;
+    }
+    blink::WebLocalFrame* web_frame =
+        render_frame() ? render_frame()->GetWebFrame() : nullptr;
+    if (!web_frame) {
+      return;
+    }
+
+    const blink::WebDocument doc = web_frame->GetDocument();
+    const GURL url = doc.IsNull() ? GURL() : GURL(doc.Url());
+    const bool allowed_url = url.is_empty() || url.SchemeIsHTTPOrHTTPS() ||
+                             url.IsAboutBlank() || url.IsAboutSrcdoc();
+    if (!allowed_url) {
+      return;
+    }
+
+    bool is_desktop_mac_frame = false;
+    if (blink::WebLocalFrameClient* client = web_frame->Client();
+        client && !client->UserAgentOverride().IsEmpty()) {
+      if (std::optional<blink::UserAgentMetadata> override_meta =
+              client->UserAgentMetadataOverride();
+          override_meta.has_value()) {
+        is_desktop_mac_frame =
+            blink::curium::IsDesktopMacParityActive(*override_meta);
+      } else {
+        is_desktop_mac_frame =
+            blink::curium::IsDesktopMacParityActive(/*is_desktop_slot=*/true);
+      }
+    } else if (blink::Platform* platform = blink::Platform::Current()) {
+      is_desktop_mac_frame = blink::curium::IsDesktopMacParityActive(
+          platform->UserAgentMetadata());
+    } else {
+      is_desktop_mac_frame = blink::curium::IsDesktopMacLaunchProfile();
+    }
+
+    if (!is_desktop_mac_frame) {
+      return;
+    }
+    InstallCuriumDesktopChromeObject(context);
+  }
+
+  void OnDestruct() override { delete this; }
+};
