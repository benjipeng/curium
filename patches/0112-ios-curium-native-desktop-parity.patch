+v8::Local<v8::String> MakeV8String(v8::Isolate* isolate,
+                                   std::string_view value) {
+  return v8::String::NewFromUtf8(isolate, value.data(),
+                                 v8::NewStringType::kNormal,
+                                 static_cast<int>(value.size()))
+      .ToLocalChecked();
+}
+
+v8::Local<v8::String> MakeV8Key(v8::Isolate* isolate, std::string_view key) {
+  return v8::String::NewFromUtf8(isolate, key.data(),
+                                 v8::NewStringType::kInternalized,
+                                 static_cast<int>(key.size()))
+      .ToLocalChecked();
+}
+
+v8::MaybeLocal<v8::Function> MakeNativeFunction(
+    v8::Isolate* isolate,
+    v8::Local<v8::Context> context,
+    v8::FunctionCallback callback,
+    std::string_view name) {
+  v8::Local<v8::String> v8_name = MakeV8String(isolate, name);
+  v8::Local<v8::FunctionTemplate> tmpl = v8::FunctionTemplate::New(
+      isolate, callback, v8::Local<v8::Value>(), v8::Local<v8::Signature>(),
+      /*length=*/0, v8::ConstructorBehavior::kThrow);
+  tmpl->RemovePrototype();
+  tmpl->SetClassName(v8_name);
+  v8::Local<v8::Function> fn;
+  if (!tmpl->GetFunction(context).ToLocal(&fn)) {
+    return v8::MaybeLocal<v8::Function>();
+  }
+  fn->SetName(v8_name);
+  return fn;
+}
+
+bool HasDefinedProperty(v8::Isolate* isolate,
+                        v8::Local<v8::Context> context,
+                        v8::Local<v8::Object> object,
+                        std::string_view key) {
+  v8::Local<v8::Value> value;
+  return object->Get(context, MakeV8Key(isolate, key)).ToLocal(&value) &&
+         !value->IsUndefined();
+}
+
+bool SetProperty(v8::Isolate* isolate,
+                 v8::Local<v8::Context> context,
+                 v8::Local<v8::Object> object,
+                 std::string_view key,
+                 v8::Local<v8::Value> value) {
+  return object->Set(context, MakeV8Key(isolate, key), value).FromMaybe(false);
+}
+
+void CuriumLoadTimesCallback(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  v8::Isolate* isolate = info.GetIsolate();
+  v8::Local<v8::Context> context = isolate->GetCurrentContext();
+  if (context.IsEmpty()) {
+    info.GetReturnValue().Set(v8::Null(isolate));
+    return;
+  }
+
+  double request_time = base::Time::Now().InSecondsFSinceUnixEpoch();
+  double start_load_time = request_time;
+  double commit_load_time = 0.0;
+  double finish_document_load_time = 0.0;
+  double finish_load_time = 0.0;
+  double first_paint_time = 0.0;
+  constexpr double kFirstPaintAfterLoadTime = 0.0;
+  std::string_view navigation_type = "Other";
+  bool was_fetched_via_spdy = true;
+  bool was_alpn_negotiated = true;
+  std::string alpn_negotiated_protocol = "h2";
+  bool was_alternate_protocol_available = false;
+  std::string connection_info = "h2";
+
+  if (blink::WebLocalFrame* frame =
+          blink::WebLocalFrame::FrameForCurrentContext()) {
+    if (blink::WebDocumentLoader* loader = frame->GetDocumentLoader()) {
+      const blink::WebURLResponse& response = loader->GetWebResponse();
+      const blink::WebPerformanceTimings timings = frame->PerformanceTimings();
+      if (timings.navigation_start > 0.0) {
+        request_time = timings.ToEpochTime().InSecondsF();
+        start_load_time = request_time;
+        commit_load_time =
+            timings.ToEpochTime(timings.response_start).InSecondsF();
+        finish_document_load_time =
+            timings.ToEpochTime(timings.dom_content_loaded_event_end)
+                .InSecondsF();
+        finish_load_time =
+            timings.ToEpochTime(timings.load_event_end).InSecondsF();
+        first_paint_time =
+            timings.ToEpochTime(timings.first_paint).InSecondsF();
+      }
+      navigation_type = GetLoadTimesNavigationType(loader->GetNavigationType());
+      if (!response.IsNull()) {
+        was_fetched_via_spdy = response.WasFetchedViaSPDY();
+        was_alpn_negotiated = response.WasAlpnNegotiated();
+        alpn_negotiated_protocol = response.AlpnNegotiatedProtocol().Utf8();
+        was_alternate_protocol_available =
+            response.WasAlternateProtocolAvailable();
+        connection_info = std::string(
+            net::HttpConnectionInfoToString(response.ConnectionInfo()));
+      }
+    }
+  }
+
+  v8::Local<v8::Object> result = v8::Object::New(isolate);
+  if (!SetProperty(isolate, context, result, "requestTime",
+                   v8::Number::New(isolate, request_time)) ||
+      !SetProperty(isolate, context, result, "startLoadTime",
+                   v8::Number::New(isolate, start_load_time)) ||
+      !SetProperty(isolate, context, result, "commitLoadTime",
+                   v8::Number::New(isolate, commit_load_time)) ||
+      !SetProperty(isolate, context, result, "finishDocumentLoadTime",
+                   v8::Number::New(isolate, finish_document_load_time)) ||
+      !SetProperty(isolate, context, result, "finishLoadTime",
+                   v8::Number::New(isolate, finish_load_time)) ||
+      !SetProperty(isolate, context, result, "firstPaintTime",
+                   v8::Number::New(isolate, first_paint_time)) ||
+      !SetProperty(isolate, context, result, "firstPaintAfterLoadTime",
+                   v8::Number::New(isolate, kFirstPaintAfterLoadTime)) ||
+      !SetProperty(isolate, context, result, "navigationType",
+                   MakeV8String(isolate, navigation_type)) ||
+      !SetProperty(isolate, context, result, "wasFetchedViaSpdy",
+                   v8::Boolean::New(isolate, was_fetched_via_spdy)) ||
+      !SetProperty(isolate, context, result, "wasNpnNegotiated",
+                   v8::Boolean::New(isolate, was_alpn_negotiated)) ||
+      !SetProperty(isolate, context, result, "npnNegotiatedProtocol",
+                   MakeV8String(isolate, alpn_negotiated_protocol)) ||
+      !SetProperty(isolate, context, result, "wasAlternateProtocolAvailable",
+                   v8::Boolean::New(isolate,
+                                    was_alternate_protocol_available)) ||
+      !SetProperty(isolate, context, result, "connectionInfo",
+                   MakeV8String(isolate, connection_info))) {
+    info.GetReturnValue().Set(v8::Null(isolate));
+    return;
+  }
+  info.GetReturnValue().Set(result);
+}
+
+void CuriumCSICallback(const v8::FunctionCallbackInfo<v8::Value>& info) {
+  v8::Isolate* isolate = info.GetIsolate();
+  v8::Local<v8::Context> context = isolate->GetCurrentContext();
+  if (context.IsEmpty()) {
+    info.GetReturnValue().Set(v8::Null(isolate));
+    return;
+  }
+
+  int64_t start_ms = base::Time::Now().InMillisecondsSinceUnixEpoch();
+  int64_t onload_ms = start_ms;
+  double page_t = 0.0;
+  int tran = kCSITransitionOther;
+
+  if (blink::WebLocalFrame* frame =
+          blink::WebLocalFrame::FrameForCurrentContext()) {
+    if (blink::WebDocumentLoader* loader = frame->GetDocumentLoader()) {
+      const blink::WebPerformanceTimings timings = frame->PerformanceTimings();
+      if (timings.navigation_start > 0.0) {
+        start_ms = timings.ToEpochTime().InMilliseconds();
+        const int64_t dcl_ms =
+            timings.ToEpochTime(timings.dom_content_loaded_event_end)
+                .InMilliseconds();
+        onload_ms = dcl_ms > 0 ? dcl_ms : start_ms;
+        page_t = timings.now;
+      }
+      tran = GetCSITransitionType(loader->GetNavigationType());
+    }
+  }
+
+  v8::Local<v8::Object> result = v8::Object::New(isolate);
+  if (!SetProperty(isolate, context, result, "startE",
+                   v8::Number::New(isolate, static_cast<double>(start_ms))) ||
+      !SetProperty(isolate, context, result, "onloadT",
+                   v8::Number::New(isolate, static_cast<double>(onload_ms))) ||
+      !SetProperty(isolate, context, result, "pageT",
+                   v8::Number::New(isolate, page_t)) ||
+      !SetProperty(isolate, context, result, "tran",
+                   v8::Number::New(isolate, static_cast<double>(tran)))) {
+    info.GetReturnValue().Set(v8::Null(isolate));
+    return;
+  }
+  info.GetReturnValue().Set(result);
+}
+
+void CuriumAppGetDetailsCallback(
+    const v8::FunctionCallbackInfo<v8::Value>& info) {
+  info.GetReturnValue().Set(v8::Null(info.GetIsolate()));
+}
+
+void CuriumAppGetIsInstalledCallback(
