+bool IsDesktopMacParityActive(bool is_desktop_slot) {
+  if (!is_desktop_slot) {
+    return false;
+  }
+  const LaunchConfig* cfg = GetLaunchConfig();
+  if (!cfg) {
+    return true;
+  }
+  const std::string desktop_platform = cfg->desktop.platform.value_or("macOS");
+  if (desktop_platform == "macOS") {
+    return true;
+  }
+  return cfg->desktop.navigator_platform.has_value() &&
+         *cfg->desktop.navigator_platform == "MacIntel";
+}
+
+bool IsDesktopMacParityActive(const blink::UserAgentMetadata& metadata) {
+  if (metadata.mobile) {
+    return false;
+  }
+  if (!metadata.platform.empty()) {
+    return metadata.platform == "macOS";
+  }
+  return IsDesktopMacParityActive(/*is_desktop_slot=*/true);
+}
+
+bool IsDesktopMacLaunchProfile() {
+  const LaunchConfig* cfg = GetLaunchConfig();
+  if (!cfg || cfg->default_slot != DefaultSlot::kDesktop) {
+    return false;
+  }
+  return IsDesktopMacParityActive(/*is_desktop_slot=*/true);
+}
