+bool IsWordChar(unsigned char c) {
+  return base::IsAsciiAlpha(c) || base::IsAsciiDigit(c) || c == '_';
+}
+
+bool ContainsWordTokenCaseInsensitive(std::string_view haystack,
+                                      std::string_view token) {
+  if (token.empty() || haystack.size() < token.size()) {
+    return false;
+  }
+  const size_t limit = haystack.size() - token.size();
+  for (size_t i = 0; i <= limit; ++i) {
+    if (i > 0 && IsWordChar(static_cast<unsigned char>(haystack[i - 1]))) {
+      continue;
+    }
+    const size_t end = i + token.size();
+    if (end < haystack.size() &&
+        IsWordChar(static_cast<unsigned char>(haystack[end]))) {
+      continue;
+    }
+    if (base::EqualsCaseInsensitiveASCII(haystack.substr(i, token.size()),
+                                         token)) {
+      return true;
+    }
+  }
+  return false;
+}
+
+uint32_t ReadBE32(base::span<const uint8_t, 32> bytes, size_t offset) {
+  return (static_cast<uint32_t>(bytes[offset]) << 24) |
+         (static_cast<uint32_t>(bytes[offset + 1]) << 16) |
+         (static_cast<uint32_t>(bytes[offset + 2]) << 8) |
+         static_cast<uint32_t>(bytes[offset + 3]);
+}
