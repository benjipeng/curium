+std::vector<MacVoiceEntry> GetSeededMacOSVoices(std::string_view persona_seed) {
+  if (persona_seed.empty()) {
+    return std::vector<MacVoiceEntry>(kMacOSVoices.begin(), kMacOSVoices.end());
+  }
+
+  std::string seed_input;
+  seed_input.reserve(32 + persona_seed.size());
+  seed_input.append("curium.desktop.parity.voices.v1:");
+  seed_input.append(persona_seed);
+  const std::array<uint8_t, 32> digest = crypto::hash::Sha256(seed_input);
+
+  uint32_t s0 = ReadBE32(digest, 0);
+  if (s0 == 0u) {
+    s0 = 0x9e3779b9u;
+  }
+  uint32_t s1 = ReadBE32(digest, 4);
+  if (s1 == 0u) {
+    s1 = 0x85ebca6bu;
+  }
+
+  auto next_rand = [&s0, &s1]() -> uint32_t {
+    uint32_t x = s0;
+    const uint32_t y = s1;
+    s0 = y;
+    x ^= (x << 23);
+    s1 = x ^ y ^ (x >> 17) ^ (y >> 26);
+    return s1 + y;
+  };
+
+  std::vector<MacVoiceEntry> selected;
+  selected.reserve(kMacOSVoices.size());
+  for (const MacVoiceEntry& entry : kMacOSVoices) {
+    const bool is_google = std::string_view(entry.name).starts_with("Google");
+    if (entry.is_default || is_google || (next_rand() % 100u) < 72u) {
+      selected.push_back(entry);
+    }
+  }
+  return selected;
+}
+
+base::flat_map<std::string, std::string> GetMacOSEnUSKeyboardLayoutMap() {
+  std::vector<std::pair<std::string, std::string>> entries;
+  entries.reserve(kMacOSEnUSKeyboardLayout.size());
+  for (const KeyLayoutPair& pair : kMacOSEnUSKeyboardLayout) {
+    entries.emplace_back(pair.code, pair.key);
+  }
+  return base::flat_map<std::string, std::string>(std::move(entries));
+}
+
+bool IsDesktopSupportedMediaCodec(std::string_view video_content_type,
+                                  std::string_view audio_content_type,
+                                  bool* power_efficient_out) {
+  const bool has_video = !video_content_type.empty();
+  const bool has_audio = !audio_content_type.empty();
+  if (!has_video && !has_audio) {
+    return false;
+  }
+
+  bool is_vp8 = false;
+  if (has_video) {
+    is_vp8 = ContainsWordTokenCaseInsensitive(video_content_type, "vp8");
+    const bool is_desktop_video =
+        is_vp8 ||
+        ContainsWordTokenCaseInsensitive(video_content_type, "vp09") ||
+        ContainsWordTokenCaseInsensitive(video_content_type, "vp9") ||
+        ContainsWordTokenCaseInsensitive(video_content_type, "av01") ||
+        ContainsWordTokenCaseInsensitive(video_content_type, "hvc1") ||
+        ContainsWordTokenCaseInsensitive(video_content_type, "avc1");
+    if (!is_desktop_video) {
+      return false;
+    }
+  }
+
+  if (has_audio) {
+    const bool is_desktop_audio =
+        ContainsWordTokenCaseInsensitive(audio_content_type, "opus") ||
+        ContainsWordTokenCaseInsensitive(audio_content_type, "mp4a");
+    if (!is_desktop_audio) {
+      return false;
+    }
+  }
+
+  if (power_efficient_out) {
+    *power_efficient_out = !is_vp8;
+  }
+  return true;
+}
